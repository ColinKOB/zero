# Rendered by zero-home-render for the home "test". Edit the template in alien/systemd/templates.
[Unit]
Description=Zero gateway for Sam's home (Hermes: API server, board dispatcher, scheduled jobs)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/taffy
Environment=HERMES_HOME=%h/.taffy
Environment=ZERO_HOME=%h/taffy/home.json
Environment=PATH=%h/taffy/bin:%h/.local/bin:/srv/zero/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/taffy/.venv/bin/hermes gateway run
Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=default.target

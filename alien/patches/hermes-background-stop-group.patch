diff --git a/tools/sandbox_process_group.py b/tools/sandbox_process_group.py
new file mode 100644
index 00000000..6e04f312
--- /dev/null
+++ b/tools/sandbox_process_group.py
@@ -0,0 +1,30 @@
+"""Zero: how a background command starts and stops inside a Zip's container (problem reports 38 and 39).
+
+The engine used to start the command behind a wrapper shell and stop it with ``kill <wrapper pid>``. Only the wrapper
+died, so the command and everything it started went on running after Stop. Each command now leads its own process
+group, and Stop signals the whole group. The hub's morning computer check runs these same two strings in every
+container (hub/taffy_hub/zipcheck.py), so it tests what the engine does. This module imports nothing from the engine.
+"""
+
+import shlex
+
+STOP_GRACE_TENTHS = 20  # how long a stopped command has to exit by itself, in tenths of a second
+
+
+def spawn_command(command: str, temp_dir: str, log_path: str, pid_path: str, exit_path: str) -> str:
+    """Shell that starts ``command`` in its own process group and prints the group's id. setsid forks when the shell
+    already made it a group leader, so the id comes from the wrapper itself, never from ``$!``."""
+    q = shlex.quote
+    wrapper = (f"echo $$ > {q(pid_path)}; nohup bash -lc {q(command)} > {q(log_path)} 2>&1; "
+               f"rc=$?; printf '%s\\n' \"$rc\" > {q(exit_path)}")
+    return (f"mkdir -p {q(temp_dir)}; "
+            f"$(command -v setsid) sh -c {q(wrapper)} </dev/null >/dev/null 2>&1 & "
+            f"i=0; while [ ! -s {q(pid_path)} ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done; cat {q(pid_path)}")
+
+
+def stop_command(pid: int | str) -> str:
+    """Shell that stops the whole group: SIGTERM, a short wait, then SIGKILL for what is left. A command started before
+    this change is not a group leader, so the plain ``kill`` still reaches it."""
+    return (f"kill -TERM -{pid} 2>/dev/null || kill {pid} 2>/dev/null; "
+            f"i=0; while kill -0 -{pid} 2>/dev/null && [ $i -lt {STOP_GRACE_TENTHS} ]; do sleep 0.1; i=$((i+1)); done; "
+            f"kill -KILL -{pid} 2>/dev/null; true")

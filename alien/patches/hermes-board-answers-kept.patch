+# The person's answers lead the view, newest first, each cut to fit, so the whole list fits in what a compaction keeps
+# of an old kanban_show (agent/context_compressor._sum_kanban_show, Nov 19 2026). A cut one names its comment_id.
+SHOW_ANSWER_CHARS = 240
+SHOW_QUESTION_CHARS = 120
+SHOW_ANSWERS_CHARS = 1_800
+
+
+def show_answers(answers: list[dict]) -> dict[str, Any]:
+    """{"answers": newest first, each short, within SHOW_ANSWERS_CHARS; "older": the comment ids left out}."""
+    shown, older, size = [], [], 0
+    for a in answers:
+        row = {"comment_id": a["comment_id"], "question": _show_cap(a["question"], SHOW_QUESTION_CHARS),
+               "answer": _show_cap(a["answer"], SHOW_ANSWER_CHARS)}
+        if len(str(a["answer"] or "")) > SHOW_ANSWER_CHARS:
+            row["answer"] += f" (comment_id={a['comment_id']} reads all of it)"
+        cost = len(json.dumps(row, ensure_ascii=False))
+        if shown and size + cost > SHOW_ANSWERS_CHARS:
+            older.append(a["comment_id"])
+            continue
+        shown.append(row)
+        size += cost
+    return {"answers": shown, "older": older}
+
+
+_SHOW_HOW = ("answers_from_the_person: the person's own answers on this task, newest first, each with its question. They are the "
              "source of truth: use them as given, never ask for them again, never set them aside as unverified. Call "
              "kanban_show again any time. Older comments are one line each or left out: page=1, 2... reads them. A "
              "comment that says it was cut: comment_id=<its id> reads all of it.")

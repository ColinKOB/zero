     return requested, branch_name
 
 
+def _own_scratch_root(root: Path, assignee: Optional[str]) -> Path:
+    """Zero (report 82): a Zip's container mounts only ``<root>/<zip>``, never the folders of the other Zips, so its
+    board tasks work there. Anyone without that folder (the lead on the server itself) keeps using ``root``."""
+    name = assignee or ""
+    own = root / name
+    return own if name.replace("-", "").replace("_", "").isalnum() and own.is_dir() else root
+
+
 def resolve_workspace(task: Task, *, board: Optional[str] = None) -> Path:
     """Resolve (and create if needed) the workspace for a task.
 
@@ -787,8 +795,12 @@ def resolve_workspace(task: Task, *, board: Optional[str] = None) -> Path:
     kind = task.workspace_kind or "scratch"
     if kind == "worktree":
         return _resolve_worktree_workspace(task, board=board)[0]
-    if kind == "scratch" and not task.workspace_path:
-        p = _kb.workspaces_root(board=board) / task.id
+    root = _kb.workspaces_root(board=board)
+    own = _own_scratch_root(root, task.assignee)
+    # A folder picked before the Zip had its own was never visible in its container, so it holds nothing to keep.
+    if kind == "scratch" and (not task.workspace_path
+                              or (own != root and Path(task.workspace_path).expanduser().parent == root)):
+        p = own / task.id
     elif kind == "scratch":
         # Legacy explicit-path scratch tasks get the same absolute-path guard
         # as dir: — same threat model.

+# Zero (Nov 20 2026, Colin): a private Zip's words go only to the company its own model runs on. A Zip whose model
+# another company runs (Muse Ember, on Meta) reads them as a third Zip would, even on its own task: the private Zip's
+# comments, the body it wrote and its results stay out of everything assembled for that Zip here. The one answer to
+# "same company" is the Zero plugin's models.same_company, read by path from the home's settings (ZERO_HOME), so the
+# hub, the plugin and the board can never disagree. Settings that can't be read count as one company, as before.
+_SAME_COMPANY_CACHE: dict = {}
+
+
+def reads_privately(reader: str, private: str) -> bool:
+    if not reader or reader == private:
+        return True
+    try:
+        import importlib.util
+        settings = Path(os.environ.get("ZERO_HOME") or Path.home() / "taffy" / "home.json").expanduser()
+        home = json.loads(settings.read_text())
+        plugin = Path(os.path.expanduser(str((home.get("paths") or {}).get("plugin") or "~/taffy/plugins/taffy-tools")))
+        stamp = (str(plugin), (plugin / "models.py").stat().st_mtime)
+        models = _SAME_COMPANY_CACHE.get(stamp)
+        if models is None:
+            spec = importlib.util.spec_from_file_location("zero_board_models", plugin / "models.py")
+            models = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(models)
+            _SAME_COMPANY_CACHE.clear()
+            _SAME_COMPANY_CACHE[stamp] = models
+        return bool(models.same_company(models.setup(home.get("models")), private, reader))
+    except Exception:
+        return True
+
+
+def withheld_from(reader: str) -> set:
+    """The private Zips whose words `reader` may not read (reads_privately)."""
+    return {p for p in PRIVATE_ZIPS if not reads_privately(reader or "default", p)}
+
+
+def _withheld_note(n: int) -> str:
+    return (f"_({n} comment{'s' if n != 1 else ''} from a Zip whose work stays with its own AI company "
+            f"{'are' if n != 1 else 'is'} left out.)_")
 
 

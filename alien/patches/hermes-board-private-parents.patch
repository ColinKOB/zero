+# Zero (Nov 19 2026): a Zip whose work stays its own (the hub's config.PRIVATE_ZIPS; ZERO_PRIVATE_ZIPS names them, comma
+# separated). Its task's result reaches a child task only when that Zip does the child or handed it over; any other
+# Zip's context names the parent by its title alone, which may cross (the hub's config.CROSSES). A parent such a Zip
+# handed to another Zip is still its work (Codex on #1090).
+PRIVATE_ZIPS = frozenset(z.strip() for z in os.environ.get("ZERO_PRIVATE_ZIPS", "connect").split(",") if z.strip())
+
+
+def _private_parent(pt, child) -> bool:
+    owners = {pt.assignee or "default", pt.created_by or ""}
+    private = owners & PRIVATE_ZIPS
+    return bool(private) and (child is None or not ((child.assignee or "default") in owners or child.created_by in private))
+

+# Zero (Nov 19 2026): a Zip read the person's answer "To the question \"What country and state were you born in?\", the
+# answer is: ...", called it unsupported because its own earlier note doubted it, and asked again. The comment thread
+# framed the answer as "comment from worker `<name>`" among fifteen others, and keeps only the newest 30. The person's
+# answers now have their own section, always whole, each with its question. An answer given on a card reaches the task
+# as the person's comment, or as the hub's unblock note "<name> answered in the app: ...".
+_APP_ANSWER = re.compile(r"\banswered in the app:\s*(.*)$", re.S)
+_ANSWER_QUESTION = re.compile(r'^To the question "(.+?)", the answer is:\s*(.*)$', re.S)
+
+
+def is_person_comment(comment: Comment, assistants: set[str]) -> bool:
+    """A comment in the person's own words: by an author who is no assistant profile (and no hub note), or an answer
+    the person gave on a card."""
+    body = (comment.body or "").lstrip()
+    if _APP_ANSWER.search(body):
+        return True
+    return (comment.author or "") not in assistants and not body.startswith("[Hub note")
+
+
+def assistant_profiles(conn: sqlite3.Connection) -> set[str]:
+    """Every profile that has had a task on the board. A comment by any other author is from a person."""
+    return {r[0] for r in conn.execute("SELECT DISTINCT assignee FROM tasks WHERE assignee IS NOT NULL")}
+
+
+def person_answers(conn: sqlite3.Connection, comments: list[Comment]) -> list[dict]:
+    """The person's answers on a task, oldest first: comment_id, created_at, the question it answered (None when it
+    named none) and the answer."""
+    assistants = assistant_profiles(conn)
+    out = []
+    for c in comments:
+        if not is_person_comment(c, assistants):
+            continue
+        text = (c.body or "").strip()
+        found = _APP_ANSWER.search(text)
+        text = found.group(1).strip() if found else text
+        asked = _ANSWER_QUESTION.match(text)
+        out.append({"comment_id": c.id, "created_at": c.created_at, "question": asked.group(1) if asked else None,
+                    "answer": asked.group(2).strip() if asked else text})
+    return out
+
+
+def _ctx_person_answers(lines: list[str], answers: list[dict], now: int) -> None:
+    if not answers:
+        return
+    lines.append("## The person's answers on this task")
+    lines.append("_The person's own words. They are the source of truth for this task: use them as given, never ask "
+                 "for them again, and never set them aside as unverified, even where an earlier note doubted them._")
+    for a in answers:
+        asked = f' to "{a["question"]}"' if a["question"] else ""
+        lines.append(f"- {_ctx_stamp(a['created_at'], now)}, answer{asked}: {a['answer']}")
+    lines.append("")
+
+

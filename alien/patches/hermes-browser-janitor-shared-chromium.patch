+"""The janitor never closes a local browser session while another local session of the same task is in use.
+
+In a served profile browser_exec keys its session "<task>@<profile home>" and the browser tools key theirs "<task>";
+both attach to one Bot Desktop Chromium. On Oct 9 School used browser_exec once, then browser_steps for two minutes;
+the janitor closed the idle browser_exec session, which closed the Chromium the browser tools were using."""
+
+import time
+from unittest.mock import patch
+
+from tools import browser_tool_lifecycle as bt_lifecycle
+
+TASK = "api_1791379260_fe9e810f"
+EXEC_KEY = f"{TASK}@/home/u/.taffy/profiles/school"
+
+
+class TestJanitorSiblings:
+    def setup_method(self):
+        from tools import browser_tool
+        self.bt = browser_tool
+        self.saved = (browser_tool._active_sessions.copy(), browser_tool._session_last_activity.copy())
+        browser_tool._active_sessions.clear()
+        browser_tool._session_last_activity.clear()
+
+    def teardown_method(self):
+        for live, saved in zip((self.bt._active_sessions, self.bt._session_last_activity), self.saved):
+            live.clear()
+            live.update(saved)
+
+    def _local(self, key, name, idle_for):
+        self.bt._active_sessions[key] = {"session_name": name, "bb_session_id": None, "cdp_url": None,
+                                         "features": {"local": True}}
+        self.bt._session_last_activity[key] = time.time() - idle_for
+
+    def test_idle_exec_session_stays_while_the_tools_session_is_busy(self):
+        timeout = self.bt.BROWSER_SESSION_INACTIVITY_TIMEOUT
+        self._local(EXEC_KEY, "h_exec", idle_for=timeout + 5)
+        self._local(TASK, "h_tools", idle_for=1)
+        with patch("tools.browser_tool_lifecycle.cleanup_browser") as cleanup:
+            bt_lifecycle._cleanup_inactive_browser_sessions()
+        cleanup.assert_not_called()
+        assert time.time() - self.bt._session_last_activity[EXEC_KEY] < 5
+
+    def test_both_idle_are_both_closed(self):
+        timeout = self.bt.BROWSER_SESSION_INACTIVITY_TIMEOUT
+        self._local(EXEC_KEY, "h_exec", idle_for=timeout + 5)
+        self._local(TASK, "h_tools", idle_for=timeout + 5)
+        with patch("tools.browser_tool_lifecycle.cleanup_browser") as cleanup:
+            bt_lifecycle._cleanup_inactive_browser_sessions()
+        assert sorted(c.args[0] for c in cleanup.call_args_list) == sorted([EXEC_KEY, TASK])
+
+    def test_another_tasks_activity_does_not_keep_a_session(self):
+        timeout = self.bt.BROWSER_SESSION_INACTIVITY_TIMEOUT
+        self._local(EXEC_KEY, "h_exec", idle_for=timeout + 5)
+        self._local("api_other", "h_other", idle_for=1)
+        with patch("tools.browser_tool_lifecycle.cleanup_browser") as cleanup:
+            bt_lifecycle._cleanup_inactive_browser_sessions()
+        assert [c.args[0] for c in cleanup.call_args_list] == [EXEC_KEY]
+
+    def test_a_cloud_session_is_not_kept_by_a_local_sibling(self):
+        timeout = self.bt.BROWSER_SESSION_INACTIVITY_TIMEOUT
+        self.bt._active_sessions[EXEC_KEY] = {"session_name": "c1", "bb_session_id": "bb", "cdp_url": "ws://x",
+                                              "features": {}}
+        self.bt._session_last_activity[EXEC_KEY] = time.time() - timeout - 5
+        self._local(TASK, "h_tools", idle_for=1)
+        with patch("tools.browser_tool_lifecycle.cleanup_browser") as cleanup:
+            bt_lifecycle._cleanup_inactive_browser_sessions()
+        assert [c.args[0] for c in cleanup.call_args_list] == [EXEC_KEY]

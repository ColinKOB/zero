+def _session_base(task_id: str) -> str:
+    """The task a session key belongs to: browser_exec's served-profile tag (``@<home>``) and the hybrid local
+    sidecar suffix stripped."""
+    base = task_id.split("@", 1)[0]
+    return base[: -len(_bt._LOCAL_SUFFIX)] if _bt._is_local_sidecar_key(base) else base
+
+
+def _local_sibling_active(task_id: str, now: float) -> bool:
+    """True when ``task_id`` is a local session and another local session of the same task is still active: both
+    drive the same Bot Desktop browser, so neither may be closed while the other is in use."""
+    with _bt._cleanup_lock:
+        sessions = dict(_bt._active_sessions)
+        activity = dict(_bt._session_last_activity)
+    if not ((sessions.get(task_id) or {}).get("features") or {}).get("local"):
+        return False
+    base = _session_base(task_id)
+    return any(other != task_id and _session_base(other) == base
+               and ((sessions.get(other) or {}).get("features") or {}).get("local")
+               and now - last <= _bt.BROWSER_SESSION_INACTIVITY_TIMEOUT
+               for other, last in activity.items())
+
+

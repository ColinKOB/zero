+def _read_tab_showing(session_key: str, url: str) -> Optional[Dict[str, Any]]:
+    """When a tab that opened after this one took over as the active tab, make the one showing ``url`` active again and
+    snapshot it. agent-browser adds a new tab at the end of its list and makes it active, so that is the case only when
+    the active tab is the last one and another shows ``url``. Otherwise None: the page itself moved on (a redirect
+    after load), and the snapshot as taken is the truth."""
+    listed = _session._run_browser_command(session_key, "tab", ["list"])
+    tabs = ((listed.get("data") or {}).get("tabs") or []) if listed.get("success") else []
+    if not tabs or not tabs[-1].get("active"):
+        return None
+    tab = next((t for t in tabs[:-1] if t.get("url") == url and t.get("tabId")), None)
+    if tab is None or not _session._run_browser_command(session_key, "tab", [str(tab["tabId"])]).get("success"):
+        return None
+    again = _session._run_browser_command(session_key, "snapshot", ["-c"])
+    return again if again.get("success") else None
+
+
+# agent-browser waits for the page's load event for 25 s, then answers "Timeout waiting for Page.loadEventFired" while the
+# page carries on loading in its tab. Scholar, Nov 16 2026 (friction list item 20): "navigation repeatedly reported
+# failure even though the requested page loaded ... distinguish a slow load from failure. That would prevent false access
+# blockers and repeated sign-ins." Hermes's own command timeout (the browser itself stuck) stays a failure.
+_STILL_LOADING_ERRORS = ("timeout waiting for page.loadeventfired", "timeout waiting for page.domcontenteventfired")
+STILL_LOADING_NOTE = ("The page hasn't finished loading, so this is what it shows so far. Don't open it again: read it "
+                      "with browser_snapshot in a few seconds if something you need is missing.")
+STILL_LOADING_UNREAD = ("The page hasn't finished loading and can't be read yet. Don't open it again: wait a few seconds, "
+                        "then read it with browser_snapshot.")
+
+
+def _still_loading(error: str) -> bool:
+    return any(words in str(error or "").lower() for words in _STILL_LOADING_ERRORS)

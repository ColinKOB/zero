@@ -0,0 +1,142 @@
+"""A summary that an idle compaction finished after the person's next message cancelled it, kept for the next one.
+
+Oct 29 2026 (Zero): an idle compaction takes about two minutes, and a message arriving in that time cancelled it and
+threw the summary away. Over Oct 26 to 29, 28 of Zero's 69 runs went this way (25 minutes of summary calls), and each
+next turn went out with the whole uncompacted history. Now the cancelled summary call keeps running beside the turn
+(``keep_call``), and its text is kept here with the exact turns it covers. The next compaction of that chat, idle or
+not, ends its summarized span where the kept one ended (``pinned_end``), so the turns are the same, and takes the text
+instead of calling the summarizer again (``take``). Everything after that span, the reply included, stays as the
+verbatim tail. The summary is the one the summarizer wrote; nothing about how it is written changes.
+"""
+
+import contextvars
+import hashlib
+import json
+import logging
+import threading
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+KEEP_SECONDS = 3600.0   # a kept summary older than this is dropped; the chat has moved on
+POLL_SECONDS = 0.2
+
+_lock = threading.Lock()
+_kept: Dict[str, Dict[str, Any]] = {}
+
+
+def _digest(value: Any) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, default=str).encode()).hexdigest()
+
+
+def row_digests(messages: List[Dict[str, Any]]) -> List[str]:
+    """One digest per message, from what the summarizer reads of it (role, content, tool calls and their ids)."""
+    return [_digest([m.get("role"), m.get("content"), m.get("tool_calls"), m.get("tool_call_id")]) for m in messages]
+
+
+def summary_key(content_to_summarize: str, previous_summary: Optional[str]) -> str:
+    return _digest([content_to_summarize, previous_summary or ""])
+
+
+def _live(session_id: str) -> Optional[Dict[str, Any]]:
+    entry = _kept.get(session_id)
+    if entry is not None and time.monotonic() - entry["at"] > KEEP_SECONDS:
+        _kept.pop(session_id, None)
+        return None
+    return entry
+
+
+def pinned_end(session_id: str, messages: List[Dict[str, Any]], start: int, end: int) -> int:
+    """``end``, or where the kept summary's span ends when ``messages`` still hold that span from ``start``."""
+    with _lock:
+        entry = _live(session_id)
+    if entry is None:
+        return end
+    window = entry["window"]
+    stop = start + len(window)
+    if start < stop <= end and row_digests(messages[start:stop]) == window:
+        return stop
+    return end
+
+
+def take(session_id: str, key: str, cancelled: Callable[[], bool]) -> Optional[str]:
+    """The kept summary text for exactly these turns and previous summary, once. While its call is still running,
+    wait for it rather than start a second one; ``cancelled()`` ends the wait and leaves it kept."""
+    from agent.auxiliary_client import AuxiliaryExplicitCancellation
+
+    with _lock:
+        entry = _live(session_id)
+    if entry is None:
+        return None
+    if entry["key"] != key:   # its turns are gone, or the summary before them changed: it no longer fits
+        with _lock:
+            if _kept.get(session_id) is entry:
+                _kept.pop(session_id)
+        return None
+    while not entry["done"].wait(POLL_SECONDS):
+        if cancelled():
+            raise AuxiliaryExplicitCancellation()
+    with _lock:
+        if _kept.get(session_id) is entry:
+            _kept.pop(session_id)
+    if entry["content"]:
+        logger.info("Using the kept compaction summary for session %s", session_id)
+    return entry["content"]
+
+
+def keep_call(session_id: str, window: List[str], key: str, call: Callable[[], str],
+              cancelled: Callable[[], bool]) -> str:
+    """Run ``call`` on its own thread and return its text. When ``cancelled()`` turns true first, raise
+    AuxiliaryExplicitCancellation at once and keep the call going: its text is kept for ``take`` with ``window``
+    and ``key``. An error reaches the caller as before; a late one only drops the kept entry."""
+    from agent.auxiliary_client import AuxiliaryExplicitCancellation
+
+    entry = {"window": list(window), "key": key, "content": None, "done": threading.Event(), "at": time.monotonic()}
+    box: Dict[str, Any] = {}
+    finished = threading.Event()
+    context = contextvars.copy_context()
+
+    def run_hooked() -> None:
+        try:
+            box["content"] = context.run(hooked)
+        except BaseException as exc:   # the caller's, or logged once the caller has gone
+            box["error"] = exc
+        with _lock:
+            finished.set()
+            entry["content"] = box.get("content")
+            entry["done"].set()
+        if entry.get("kept"):
+            if "error" in box:
+                logger.info("Kept compaction summary call for session %s failed: %s", session_id, box["error"])
+            else:
+                logger.info("Kept compaction summary for session %s is ready (%d messages)", session_id,
+                            len(window))
+
+    from agent import auxiliary_client as aux
+
+    # The waiting host's progress hook and stream deadline are thread-local: carry them, so its stall check sees the
+    # summary moving and an abandoned stream still ends at the host's own deadline.
+    progress, deadline = getattr(aux._aux_progress, "hook", None), aux._current_aux_stream_deadline()
+
+    def hooked() -> str:
+        with aux.aux_progress_hook(progress), aux.aux_stream_deadline(deadline):
+            return call()
+
+    threading.Thread(target=lambda: run_hooked(), name="compaction-summary-kept", daemon=True).start()
+    while not finished.wait(POLL_SECONDS):
+        if cancelled():
+            with _lock:
+                if session_id and window:
+                    entry["kept"] = True
+                    _kept[session_id] = entry
+            logger.info("Compaction summary for session %s keeps running after a cancel", session_id)
+            raise AuxiliaryExplicitCancellation()
+    if "error" in box:
+        raise box["error"]
+    return box["content"]
+
+
+def clear() -> None:
+    with _lock:
+        _kept.clear()

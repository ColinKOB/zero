diff --git a/tests/agent/test_compaction_carry.py b/tests/agent/test_compaction_carry.py
new file mode 100644
index 0000000..fded6f0
--- /dev/null
+++ b/tests/agent/test_compaction_carry.py
@@ -0,0 +1,137 @@
+"""A summary an idle compaction finished after the person's next message cancelled it is used by the next compaction.
+
+Oct 28 2026, 8:44 to 8:50 a.m. (Zero): six idle compactions in a row were cancelled by the next message, each after up
+to two minutes of summary work, and each next one summarized a longer span from scratch (79,858 to 119,649 prompt
+characters).
+"""
+
+import threading
+import time
+from unittest.mock import patch
+
+import pytest
+
+from agent import compaction_carry as carry
+from agent.auxiliary_client import AuxiliaryExplicitCancellation
+from agent.context_compressor import ContextCompressor
+
+SUMMARY = ("## Goal\nPlan the PodGuard social posts.\n\n## Progress\nThe two-week calendar for Nov 2 to 15 is ready "
+           "with 10 X posts and 6 Instagram posts.")
+
+
+@pytest.fixture(autouse=True)
+def _clear():
+    carry.clear()
+    yield
+    carry.clear()
+
+
+def _compressor(session_id="api_zero") -> ContextCompressor:
+    with patch("agent.context_compressor.get_model_context_length", return_value=8000):
+        comp = ContextCompressor(model="test-model", threshold_percent=0.75, protect_first_n=3, protect_last_n=4,
+                                 quiet_mode=True)
+    comp._session_id = session_id
+    return comp
+
+
+def _history(turns=12):
+    messages = [{"role": "system", "content": "sys"}]
+    for i in range(turns):
+        messages += [{"role": "user", "content": f"Question {i}: " + "what about the calendar? " * 20},
+                     {"role": "assistant", "content": f"Answer {i}: " + "the calendar is on track. " * 20}]
+    return messages
+
+
+def _plain(messages):
+    return [{k: m.get(k) for k in ("role", "content", "tool_calls", "tool_call_id")} for m in messages]
+
+
+def _summary_row(messages):
+    return next(m for m in messages if ContextCompressor._is_context_summary_message(m))
+
+
+def test_a_cancelled_call_keeps_running_and_its_text_is_taken_once():
+    gate, cancel = threading.Event(), threading.Event()
+    threading.Timer(0.3, cancel.set).start()
+    started = time.monotonic()
+    with pytest.raises(AuxiliaryExplicitCancellation):
+        carry.keep_call("api_zero", ["d1"], "k1", lambda: gate.wait(5) and "the summary", cancel.is_set)
+    assert time.monotonic() - started < 2   # the turn does not wait for the summary
+    gate.set()
+    assert carry.take("api_zero", "k1", lambda: False) == "the summary"   # waits for the running call
+    assert carry.take("api_zero", "k1", lambda: False) is None
+
+
+def test_a_kept_summary_for_other_turns_is_dropped():
+    carry.keep_call("api_zero", ["d1"], "k1", lambda: "x", lambda: False)   # finished normally: nothing kept
+    assert carry.take("api_zero", "k1", lambda: False) is None
+    cancel = threading.Event()
+    cancel.set()
+    with pytest.raises(AuxiliaryExplicitCancellation):
+        carry.keep_call("api_zero", ["d1"], "k1", lambda: time.sleep(0.3) or "x", cancel.is_set)
+    assert carry.take("api_zero", "other", lambda: False) is None
+    assert carry.take("api_zero", "k1", lambda: False) is None
+
+
+def test_the_next_compaction_uses_the_cancelled_summary_with_the_reply_kept_after_it():
+    history = _history()
+    gate, keep = threading.Event(), threading.Event()
+    prompts = []
+
+    def slow_summary(prompt, started, check_cancel=True):
+        prompts.append(prompt)
+        gate.wait(10)
+        return SUMMARY
+
+    first = _compressor()
+    first._keep_summary_if = keep
+    threading.Timer(0.3, keep.set).start()   # Colin writes back while the summary is being written
+    with patch.object(first, "_call_summary_llm", slow_summary), pytest.raises(AuxiliaryExplicitCancellation):
+        first.compress([dict(m) for m in history], current_tokens=7000)
+    gate.set()
+
+    reply = [{"role": "user", "content": "Add a post for Friday."},
+             {"role": "assistant", "content": "Added a Friday post to the calendar."}]
+    second = _compressor()   # the next idle job builds a fresh agent
+    with patch.object(second, "_call_summary_llm", side_effect=AssertionError("summarized again")):
+        out = second.compress([dict(m) for m in history + reply], current_tokens=7200)
+    assert len(prompts) == 1
+    assert _plain(out[-2:]) == _plain(reply)
+
+    plain = _compressor()   # the same turns, never cancelled (the kept entry was used up)
+    with patch.object(plain, "_call_summary_llm", return_value=SUMMARY):
+        expected = plain.compress([dict(m) for m in history], current_tokens=7000)
+    assert _summary_row(out)["content"] == _summary_row(expected)["content"]
+    assert _plain(out[:-2]) == _plain(expected)   # same head, summary and tail; the reply comes after
+
+
+def test_a_foreground_compaction_waits_for_the_running_call_instead_of_a_second_one():
+    history = _history()
+    gate, keep = threading.Event(), threading.Event()
+    calls = []
+
+    def slow_summary(prompt, started, check_cancel=True):
+        calls.append(prompt)
+        gate.wait(10)
+        return SUMMARY
+
+    first = _compressor()
+    first._keep_summary_if = keep
+    keep.set()
+    with patch.object(first, "_call_summary_llm", slow_summary), pytest.raises(AuxiliaryExplicitCancellation):
+        first.compress([dict(m) for m in history], current_tokens=7000)
+    threading.Timer(0.3, gate.set).start()
+    second = _compressor()
+    with patch.object(second, "_call_summary_llm", side_effect=AssertionError("summarized again")):
+        out = second.compress([dict(m) for m in history + [{"role": "user", "content": "next"}]],
+                              current_tokens=7200)
+    assert len(calls) == 1
+    assert SUMMARY.splitlines()[1] in _summary_row(out)["content"]
+
+
+def test_without_the_idle_flag_a_summary_call_runs_as_before():
+    comp = _compressor()
+    with patch.object(comp, "_call_summary_llm", return_value=SUMMARY) as call:
+        comp.compress([dict(m) for m in _history()], current_tokens=7000)
+    call.assert_called_once()
+    assert carry._kept == {}

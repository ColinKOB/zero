+def compaction_can_wait_for_idle(agent: Any, request_tokens: Any) -> bool:
+    """Whether an automatic compaction in a chat turn can wait for the gateway's idle job (Zero, Oct 25 2026).
+
+    Between the trigger and the model's window there is headroom: 172k on a 872k window with a 700k trigger, 300k
+    on the 1M fallback window, 800k on a 1M window with a 200k trigger, 30k on a 200k window. A request under the
+    trigger plus half that headroom (and no more than a quarter of the trigger) goes out uncompacted; the other half
+    is the turn's own room to grow, for tool results and the reply. ``False`` whenever a number is unknown."""
+    compressor = getattr(agent, "context_compressor", None)
+    window = getattr(compressor, "context_length", None)
+    trigger = getattr(compressor, "threshold_tokens", None)
+    for value in (window, trigger, request_tokens):
+        if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+            return False
+    room = window - trigger
+    if room <= 0:
+        return False
+    return request_tokens < trigger + min(room // 2, trigger // 4)
+
+
+def compaction_deferred_to_idle(agent: Any, request_tokens: Any) -> bool:
+    """A chat turn on the API gateway skips an automatic compaction its request can wait for: the gateway's idle job
+    compacts after the reply (gateway/platforms/api_server_idle_compaction.py). Oct 25 2026 trials on a Zip like
+    Zero: "Do we need a park pass?" waited 148 s and a packing-list turn stalled 80 s behind a summary. Only the
+    turn-start, pre-API and post-tool decisions ask; provider overflow, error recovery and /compress never do."""
+    if getattr(agent, "_defer_compaction_to_idle", False) is not True:
+        return False
+    if not compaction_can_wait_for_idle(agent, request_tokens):
+        return False
+    logger.info("Compaction deferred to idle time: ~%s request tokens fit under the %s window (session %s)",
+                f"{request_tokens:,}", f"{agent.context_compressor.context_length:,}", agent.session_id or "none")
+    return True
+
+

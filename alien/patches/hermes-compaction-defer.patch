+++ b/tests/agent/test_compaction_defer_to_idle.py
@@ -0,0 +1,80 @@
+"""API gateway chat turns leave a compaction that can wait to the idle job (Zero, Oct 25 2026).
+
+On a Zip like Zero (Sol, 872k window, 700k trigger), "Do we need a park pass?" waited 148 s behind a summary at turn
+start and a packing-list turn stalled 80 s mid-turn. The gateway's idle job compacts after the reply instead."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent.conversation_compression import compaction_can_wait_for_idle, compaction_deferred_to_idle
+from agent.turn_preflight import compress_after_tool_results
+
+
+def zip_agent(window, trigger, defer=True):
+    return SimpleNamespace(context_compressor=SimpleNamespace(context_length=window, threshold_tokens=trigger),
+                           _defer_compaction_to_idle=defer, session_id="owned")
+
+
+@pytest.mark.parametrize("window,trigger,fits,over", [
+    (872_000, 700_000, 785_999, 786_000),     # Sol: half its 172k headroom
+    (1_000_000, 700_000, 849_999, 850_000),   # the Opus fallback's 1M window under Sol's trigger
+    (1_000_000, 200_000, 249_999, 250_000),   # a Claude Zip summarized by Haiku: a quarter of its trigger, not 400k
+    (200_000, 170_000, 184_999, 185_000),     # a 200k window
+])
+def test_each_zip_window_minus_its_trigger_decides(window, trigger, fits, over):
+    assert compaction_can_wait_for_idle(zip_agent(window, trigger), fits) is True
+    assert compaction_can_wait_for_idle(zip_agent(window, trigger), over) is False
+
+
+@pytest.mark.parametrize("window,trigger,tokens", [
+    (None, 700_000, 750_000), (872_000, None, 750_000), (872_000, 700_000, None),
+    (700_000, 700_000, 690_000), (True, 700_000, 750_000)])
+def test_unknown_or_no_headroom_never_waits(window, trigger, tokens):
+    assert compaction_can_wait_for_idle(zip_agent(window, trigger), tokens) is False
+
+
+def test_only_a_gateway_chat_turn_defers():
+    assert compaction_deferred_to_idle(zip_agent(872_000, 700_000), 750_000) is True
+    assert compaction_deferred_to_idle(zip_agent(872_000, 700_000, defer=False), 750_000) is False
+    plain = SimpleNamespace(context_compressor=SimpleNamespace(context_length=872_000, threshold_tokens=700_000))
+    assert compaction_deferred_to_idle(plain, 750_000) is False
+
+
+def _after_tools(agent):
+    return compress_after_tool_results(
+        agent, messages=[{"role": "user", "content": "current ask"}], system_message="system",
+        user_message="current ask", active_system_prompt="system", conversation_history=[],
+        compression_attempts=0, max_compression_attempts=1, effective_task_id="task", final_response="",
+        turn_exit_reason=None, current_turn_user_idx=0)
+
+
+@pytest.mark.parametrize("prompt_tokens,defer,compacts", [
+    (750_000, True, False),    # past the trigger, still fits: the reply goes first
+    (800_000, True, True),     # past the deferral line: compact now, as before
+    (750_000, False, True),    # not a gateway chat turn: unchanged
+])
+def test_post_tool_compaction_waits_while_the_request_fits(monkeypatch, prompt_tokens, defer, compacts):
+    calls = []
+
+    class Compressor:
+        last_prompt_tokens = prompt_tokens
+        threshold_tokens = 700_000
+        context_length = 872_000
+
+        @staticmethod
+        def should_compress(tokens):
+            return tokens >= 700_000
+
+    def compress(messages, *a, **kw):
+        calls.append(kw.get("approx_tokens"))
+        return [{"role": "user", "content": "compressed"}, {"role": "user", "content": "current ask"}], "system"
+
+    agent = SimpleNamespace(context_compressor=Compressor(), compression_enabled=True, session_id="owned",
+                            _defer_compaction_to_idle=defer, _clear_context_overflow_warn=lambda: None,
+                            _safe_print=lambda *_a: None, _compress_context=compress, _persist_user_message_idx=0)
+    monkeypatch.setattr("agent.turn_preflight.conversation_history_after_compression", lambda *_a: [])
+    monkeypatch.setattr("agent.conversation_loop._should_skip_model_call_for_reference_handoff", lambda *_a: False)
+    verdict = _after_tools(agent)
+    assert bool(calls) is compacts
+    assert (verdict.compression_attempts == 1) is compacts

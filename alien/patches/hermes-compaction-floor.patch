+"""Keep a compaction small enough that it does not set off the next one (Zero, Oct 28 2026).
+
+Zero's chat compacted 59 times in three days, twice four minutes apart. Each compaction left a request of about
+157k real tokens: about 97k of system prompt and tools, a 21k summary (76k characters, against a 10k target the
+summarizer ignored), 26k of team rules that every earlier user turn still carried in its ``api_content``, and 10k of
+kept turns. The gateway's idle job compacts again from 60% of the 200k trigger (120k), so it fired after nearly every
+reply, and each pass rewrote the summary and lost more of what the person had decided.
+
+This module holds the pieces the compressor calls:
+
+- ``cap_summary`` enforces a hard size on the summary, trimming the least useful sections first. It keeps the
+  person's decisions, and the summary always ends with the person's newest words and the pointer to the full history.
+- ``recent_user_quotes`` keeps the person's last 20 messages verbatim across compactions, where the lean section
+  only quoted the newest compacted region.
+- ``slim_finished_turns`` drops what a finished turn no longer needs from the kept tail: the per-turn context its
+  user message carried, its thinking, and large tool outputs. The newest user turn keeps everything. The compaction
+  boundary already invalidates the prompt cache, so this costs nothing extra; the archived originals keep every byte.
+- ``record_compaction`` appends one line per compaction to ``$HERMES_HOME/logs/compactions.jsonl`` for the hub.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import time
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+DECISIONS_HEADING = "## Decisions & Standing Preferences"
+# Oct 29 2026: dropped from every summary. The summarizer's copy of the person's open asks disagreed with the hub's
+# open loops, the one list of unfinished work, which the first turn after a compaction hears again. At 20:13 on Oct 28
+# the summary listed 20 open asks; at least 7 had been answered, two of them the day before.
+UNFINISHED_HEADING = "## Unfinished Requests"
+
+# The summary may use this share of the compaction trigger, between the bounds: 8,000 tokens on a 200k trigger.
+SUMMARY_SHARE_OF_TRIGGER = 0.04
+SUMMARY_CAP_MIN_TOKENS = 3_000
+SUMMARY_CAP_MAX_TOKENS = 10_000
+CHARS_PER_TOKEN = 4
+
+RECENT_USER_MESSAGES = 20
+USER_QUOTE_MAX_CHARS = 1_200
+USER_QUOTES_BUDGET_CHARS = 12_000
+
+# A finished turn's tool output above this size becomes a one-line pointer in the kept tail.
+FINISHED_TOOL_OUTPUT_MAX_CHARS = 1_500
+THINKING_KEYS = ("reasoning", "reasoning_content", "reasoning_details", "codex_reasoning_items")
+
+# Trimmed first to last. A section not named here (the task snapshot, goal, decisions, the person's own words, the
+# pointer to the full history, pruned skills) is never trimmed. Oct 29 2026: "## Key Decisions" left this list; the
+# summarizer files the person's decisions there too (at 20:13 on Oct 28: "Voice clone uses local open-source tools
+# only; no upload or third-party service; no spending").
+TRIM_ORDER = (
+    "## Detailed Session Log", "## Anchor Index", "## Relevant Files", "## Completed Actions",
+    "## Critical Context", "## Errors & Fixes", "## Resolved Questions", "## Blocked", "## Active State",
+)
+# The summary closes with the person's own words, newest first, and then the pointer to the full history
+# (``_augment_summary_lean``). Oct 29 2026: when the untrimmed sections were still over the cap, a plain cut at the end
+# took the pointer first and then the person's newest words.
+QUOTES_HEADING = "## User Messages"
+RECOVERY_HEADING = "## Context Recovery"
+QUOTES_NOTE = ("\n(The user's own words from before the messages below, quoted verbatim, newest first. They override "
+               "any paraphrase of them above.)")
+# Chronological sections keep their newest lines; the others keep their first lines.
+KEEP_NEWEST = ("## Detailed Session Log", "## Completed Actions")
+TRIM_NOTE = "[{n} older line(s) trimmed at compaction; session_search finds them.]"
+_SECTION_RE = re.compile(r"(?m)^(?=## )")
+
+
+def summary_cap_chars(threshold_tokens: Any) -> int:
+    """The most characters a summary body may have for a compactor with this trigger."""
+    tokens = SUMMARY_CAP_MAX_TOKENS
+    if isinstance(threshold_tokens, int) and not isinstance(threshold_tokens, bool) and threshold_tokens > 0:
+        tokens = int(threshold_tokens * SUMMARY_SHARE_OF_TRIGGER)
+    return max(SUMMARY_CAP_MIN_TOKENS, min(SUMMARY_CAP_MAX_TOKENS, tokens)) * CHARS_PER_TOKEN
+
+
+def _split_sections(text: str) -> List[List[str]]:
+    """``[[heading_line, body], ...]``; a leading entry with heading ``""`` holds any text before the first heading."""
+    out = []
+    for chunk in _SECTION_RE.split(text):
+        if chunk.startswith("## "):
+            head, _, body = chunk.partition("\n")
+            out.append([head, body])
+        elif chunk:
+            out.append(["", chunk])
+    return out
+
+
+def _join_sections(sections: List[List[str]]) -> str:
+    return "".join(f"{head}\n{body}" if head else body for head, body in sections)
+
+
+def _trim_lines(body: str, keep_chars: int, newest: bool) -> str:
+    lines = body.rstrip("\n").split("\n")
+    kept: List[str] = []
+    used = 0
+    for line in (reversed(lines) if newest else lines):
+        if used + len(line) + 1 > keep_chars:
+            break
+        kept.append(line)
+        used += len(line) + 1
+    dropped = len(lines) - len(kept)
+    if not dropped:
+        return body
+    note = TRIM_NOTE.format(n=dropped)
+    return "\n".join([note, *reversed(kept)] if newest else [*kept, note]) + "\n\n"
+
+
+def cap_summary(text: str, max_chars: int) -> str:
+    """``text`` at most ``max_chars`` long, trimmed section by section in ``TRIM_ORDER``.
+
+    A section is cut to whole lines and marked with a note; one with almost nothing left keeps only the note.
+    If the untrimmable sections alone are still over, the person's oldest quotes go next, down to the newest one,
+    and then the end of the model-written part. The summary still ends with the newest quote and the pointer to the
+    full history. Old quotes go before the model-written part because the next summary is written from this one: what
+    is cut from it is gone for good, while the old quotes are paraphrased above it and kept in session history."""
+    if len(text) <= max_chars:
+        return text
+    sections = _split_sections(text)
+    over = len(text) - max_chars
+    for prefix in TRIM_ORDER:
+        for section in sections:
+            if over <= 0:
+                break
+            head, body = section
+            if not head.startswith(prefix) or not body.strip():
+                continue
+            keep = len(body) - over - len(TRIM_NOTE) - 8
+            section[1] = _trim_lines(body, max(keep, 0), head.startswith(KEEP_NEWEST))
+            over -= len(body) - len(section[1])
+    capped = _join_sections(sections)
+    if len(capped) <= max_chars:
+        return capped
+    logger.warning("Compaction summary still %s chars after trimming; cutting to %s", len(capped), max_chars)
+    at = next((i for i, (head, _) in enumerate(sections) if head.startswith((QUOTES_HEADING, RECOVERY_HEADING))),
+              len(sections))
+    written, tail = sections[:at], sections[at:]
+    if tail and tail[0][0].startswith(QUOTES_HEADING):
+        quotes, end = _quotes_in(tail[0][1]), "\n\n" if len(tail) > 1 else ""
+        while len(quotes) > 1 and len(capped) > max_chars:
+            quotes.pop()   # newest first, so this is the oldest
+            tail[0][1] = _quote_body(quotes) + end
+            capped = _join_sections(written + tail)
+    if len(capped) > max_chars:
+        kept = _join_sections(tail)
+        start = _join_sections(written).rstrip()[:max(max_chars - len(kept) - 2, 0)].rstrip()
+        capped = f"{start}\n\n{kept}" if start else kept[:max_chars]
+    return capped
+
+
+def _quotes_in(section: str) -> List[str]:
+    """The ``> `` quote blocks of a verbatim user-message section, in order."""
+    quotes: List[str] = []
+    current: List[str] = []
+    for line in section.split("\n"):
+        if line.startswith(">"):
+            current.append(line[2:] if line.startswith("> ") else line[1:])
+        elif current:
+            quotes.append("\n".join(current))
+            current = []
+    if current:
+        quotes.append("\n".join(current))
+    return quotes
+
+
+def section_body(text: str, heading: str) -> str:
+    """The body of the first section whose heading line starts with ``heading`` ("" when absent)."""
+    for head, body in _split_sections(text or ""):
+        if head.startswith(heading):
+            return body
+    return ""
+
+
+def drop_section(text: str, heading: str) -> str:
+    """``text`` without any section whose heading line starts with ``heading``."""
+    return _join_sections([s for s in _split_sections(text) if not s[0].startswith(heading)]).rstrip()
+
+
+def recent_user_quotes(previous_summary: Optional[str], region_user_texts: List[str], heading: str,
+                       elide: Callable[[str, int], str]) -> str:
+    """The person's last ``RECENT_USER_MESSAGES`` messages, newest first, as a summary section ("" when none).
+
+    ``region_user_texts`` are the real user messages being compacted now, oldest first. Earlier ones come from the
+    previous summary's own quote section, so the section rolls forward across compactions."""
+    newest_first = [t.strip() for t in reversed(region_user_texts) if t and t.strip()]
+    newest_first += _quotes_in(section_body(previous_summary or "", heading))
+    quotes: List[str] = []
+    used = 0
+    for text in newest_first[:RECENT_USER_MESSAGES]:
+        room = min(USER_QUOTE_MAX_CHARS, USER_QUOTES_BUDGET_CHARS - used)
+        if room < 200:
+            break
+        text = elide(text, room)
+        quotes.append(text)
+        used += len(text)
+    return "\n\n" + heading + "\n" + _quote_body(quotes) if quotes else ""
+
+
+def _quote_body(quotes: List[str]) -> str:
+    """The body of the verbatim user-message section for these messages, newest first."""
+    return "\n\n".join("> " + text.replace("\n", "\n> ") for text in quotes) + QUOTES_NOTE
+
+
+def slim_finished_turns(tail: List[Dict[str, Any]], is_real_user: Callable[[Dict[str, Any]], bool],
+                        stub: Callable[[Dict[str, Any]], str]) -> int:
+    """Drop what finished turns no longer need from the kept tail, in place; returns how many rows changed.
+
+    Rows before the newest real user message lose their ``api_content`` (a user turn then replays only its own
+    words), their thinking, and tool output over ``FINISHED_TOOL_OUTPUT_MAX_CHARS``. The newest turn is untouched,
+    so a compaction in the middle of a turn keeps every block that turn's next request needs."""
+    last_user = next((i for i in range(len(tail) - 1, -1, -1) if is_real_user(tail[i])), None)
+    if last_user is None:
+        return 0
+    changed = 0
+    for msg in tail[:last_user]:
+        role = msg.get("role")
+        if role == "user" and isinstance(msg.get("content"), str) and isinstance(msg.get("api_content"), str):
+            msg.pop("api_content")
+            changed += 1
+        elif role == "assistant" and any(key in msg for key in THINKING_KEYS):
+            for key in THINKING_KEYS:
+                msg.pop(key, None)
+            changed += 1
+        elif role == "tool" and isinstance(msg.get("content"), str) \
+                and len(msg["content"]) > FINISHED_TOOL_OUTPUT_MAX_CHARS:
+            msg["content"] = stub(msg)
+            msg.pop("api_content", None)
+            changed += 1
+    return changed
+
+
+def record_compaction(entry: Dict[str, Any], home: Optional[Path] = None) -> None:
+    """Append one compaction to ``<home>/logs/compactions.jsonl``. Never raises: the log is for people reading it."""
+    try:
+        if home is None:
+            from hermes_constants import get_hermes_home
+            home = Path(get_hermes_home())
+        path = Path(home) / "logs" / "compactions.jsonl"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as f:
+            f.write(json.dumps({"at": round(time.time(), 3), **entry}, ensure_ascii=False) + "\n")
+    except Exception:
+        logger.warning("Could not record a compaction in compactions.jsonl", exc_info=True)

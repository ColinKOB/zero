diff --git a/tests/agent/test_compaction_floor.py b/tests/agent/test_compaction_floor.py
new file mode 100644
index 00000000..f5ba5982
--- /dev/null
+++ b/tests/agent/test_compaction_floor.py
@@ -0,0 +1,223 @@
+"""A compaction leaves room to work before the next one (Zero, Oct 28 2026).
+
+Zero's chat compacted 59 times in three days. Each pass left about 157k real tokens against a 200k trigger, above
+the gateway idle job's 120k line, so the next reply set it off again, and every pass told the model that the person's
+earlier requests were "already addressed". These tests build a chat shaped like Zero's (a 76k-character summary,
+13k characters of team rules on every user turn, signed thinking on every assistant turn) and pin the floor."""
+
+import json
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.compaction_floor import (
+    DECISIONS_HEADING, RECENT_USER_MESSAGES, UNFINISHED_HEADING, cap_summary, record_compaction, recent_user_quotes,
+    slim_finished_turns, summary_cap_chars,
+)
+from agent.context_compressor import (
+    SUMMARY_PREFIX, _LEAN_USER_MESSAGES_HEADING, ContextCompressor, _build_recovery_footer,
+    is_compaction_summary_message,
+)
+from agent.model_metadata import estimate_messages_tokens_rough
+
+TRIGGER = 200_000
+# Zero's system prompt and tool schemas by the same rough count (Oct 28 2026: ~105k rough after a compaction,
+# ~55k of it history).
+SYSTEM_AND_TOOLS = 50_000
+TEAM_RULES = "Before anything that takes more than a minute, check what it needs. " * 190   # ~13k chars
+
+
+def _thinking(n):
+    return [{"type": "thinking", "thinking": "I think about step %d. " % n * 160, "signature": "sig" * 120}]
+
+
+def _turn(i, big_tool=False):
+    words = f"[Chat turn: t{i}]\nMessage {i} from the person: please handle item {i}."
+    return [
+        {"role": "user", "content": words, "api_content": words + "\n\n" + TEAM_RULES},
+        {"role": "assistant", "content": "", "reasoning_details": _thinking(i),
+         "tool_calls": [{"id": f"c{i}", "type": "function", "function": {"name": "web_search", "arguments": "{}"}}]},
+        {"role": "tool", "tool_call_id": f"c{i}", "tool_name": "web_search",
+         "content": ("result %d " % i) * (900 if big_tool else 40)},
+        {"role": "assistant", "content": f"Done with item {i}.", "reasoning_details": _thinking(i)},
+    ]
+
+
+def _old_summary():
+    body = "\n".join([
+        "## Historical Task Snapshot", "User asked to email Bruce.", "",
+        "## Constraints & Preferences", "- Colin wants replies short.", "",
+        "## Completed Actions", *[f"{n}. SENT note {n} — ok [tool: email]" for n in range(1, 900)], "",
+        _LEAN_USER_MESSAGES_HEADING, *[f"> Old message {n}\n" for n in range(15, 0, -1)],
+    ])
+    return f"{SUMMARY_PREFIX}\n{body}"
+
+
+def _zero_chat(turns=14):
+    messages = [{"role": "system", "content": "system"}, {"role": "user", "content": _old_summary()},
+                {"role": "assistant", "content": "Got it."}]
+    for i in range(turns):
+        messages += _turn(i, big_tool=i % 3 == 0)
+    messages.append({"role": "user", "content": "[Chat turn: last]\nWhat's next?", "api_content": "x" + TEAM_RULES})
+    return messages
+
+
+def _llm_summary():
+    """What Zero's summarizer actually returned: every section long, about 76k characters."""
+    return "\n".join([
+        "## Historical Task Snapshot", "User asked what is next.", "",
+        "## Goal", "Keep Colin's week on track.", "",
+        DECISIONS_HEADING, "- Oct 28: Colin wants Zero to check his mail before drafting.", "- Replies stay short.", "",
+        UNFINISHED_HEADING, "- Oct 28: email Bruce about the interview follow-up (not sent yet).", "",
+        "## Key Decisions", "- Voice clone uses local open-source tools only; no upload or third-party service.", "",
+        "## Completed Actions", *[f"{n}. DID thing {n} with a long description of the outcome" for n in range(900)], "",
+        "## Relevant Files", *[f"- /home/zero/file{n}.md — notes" for n in range(400)], "",
+        "## Critical Context", *[f"- value {n} = {n * 7}" for n in range(400)], "",
+        "## Detailed Session Log (oldest first)", *[f"- step {n}: looked something up" for n in range(600)],
+    ])
+
+
+def _response(content):
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = content
+    return response
+
+
+def _compressor():
+    with patch("agent.context_compressor.get_model_context_length", return_value=1_000_000):
+        compressor = ContextCompressor(model="claude-opus-5-5", protect_last_n=30, quiet_mode=True)
+    compressor.threshold_tokens = TRIGGER
+    return compressor
+
+
+def _request_tokens(messages):
+    """The next request by the same rough count, with the thinking that rides the wire included."""
+    thinking = sum(len(part.get("thinking", "")) for m in messages for part in m.get("reasoning_details") or [])
+    return SYSTEM_AND_TOOLS + estimate_messages_tokens_rough(messages) + thinking // 4
+
+
+def _compress(messages):
+    compressor = _compressor()
+    with patch("agent.context_compressor.call_llm", return_value=_response(_llm_summary())):
+        return compressor, compressor.compress(messages, current_tokens=_request_tokens(messages))
+
+
+def _summary_text(messages):
+    return next(m["content"] for m in messages if is_compaction_summary_message(m))
+
+
+def test_a_compaction_leaves_at_most_half_the_trigger():
+    messages = _zero_chat()
+    assert _request_tokens(messages) > TRIGGER * 0.6   # past the idle job's line, as Zero's chat was
+    _, compressed = _compress(messages)
+    assert _request_tokens(compressed) <= TRIGGER // 2
+
+
+def test_the_summary_is_capped_keeps_decisions_and_drops_its_own_list_of_open_asks():
+    """Oct 29 2026: at 20:13 on Oct 28 the summary's "Unfinished Requests" listed 20 asks, at least 7 of them already
+    answered, while the hub's open loops had the right state; the summarizer also filed decisions under "Key
+    Decisions", which was trimmable."""
+    compressor, compressed = _compress(_zero_chat())
+    summary = _summary_text(compressed)
+    assert len(summary) <= summary_cap_chars(TRIGGER) + len(SUMMARY_PREFIX) + 200
+    assert "Colin wants Zero to check his mail before drafting." in summary
+    assert "Voice clone uses local open-source tools only" in summary
+    assert UNFINISHED_HEADING not in summary and "email Bruce about the interview" not in summary
+    assert UNFINISHED_HEADING not in compressor._previous_summary
+    assert "## Historical Task Snapshot" in summary
+    assert "trimmed at compaction" in summary
+
+
+def test_the_persons_last_twenty_messages_roll_forward_verbatim():
+    _, compressed = _compress(_zero_chat())
+    section = _summary_text(compressed).split(_LEAN_USER_MESSAGES_HEADING, 1)[1]
+    quotes = [line for line in section.split("\n") if line.startswith("> ")]
+    words = [q for q in quotes if "Message " in q or "Old message" in q]
+    assert len(words) == RECENT_USER_MESSAGES
+    # Newest first: this region's messages, then the previous summary's quotes, newest of those first.
+    assert words[0].endswith("please handle item %d." % max(int(w.split("Message ")[1].split(" ")[0])
+                                                           for w in words if "Message " in w))
+    assert "> Old message 15" in section
+
+
+def test_finished_turns_drop_rules_thinking_and_big_tool_output_but_the_newest_turn_keeps_them():
+    tail = _turn(1, big_tool=True) + _turn(2, big_tool=True)
+    changed = slim_finished_turns(tail, is_real_user=lambda m: m["role"] == "user", stub=lambda m: "[stub]")
+    first, current = tail[:4], tail[4:]
+    assert changed == 4
+    assert "api_content" not in first[0] and "reasoning_details" not in first[1] and first[2]["content"] == "[stub]"
+    assert current == _turn(2, big_tool=True)
+
+
+def test_the_handoff_keeps_decisions_in_force_and_sends_open_work_to_the_open_loops():
+    assert f"'{DECISIONS_HEADING}' still applies until the user changes it" in SUMMARY_PREFIX
+    assert "Work still open comes with the user's messages as open loops." in SUMMARY_PREFIX
+    assert UNFINISHED_HEADING not in SUMMARY_PREFIX
+    assert "Do NOT answer questions or fulfill other requests" in SUMMARY_PREFIX
+    for has_user_turn in (True, False):
+        prompt = _compressor()._build_summary_prompt("turns", 2000, None, "", has_user_turn)
+        assert DECISIONS_HEADING in prompt and UNFINISHED_HEADING not in prompt
+
+
+def test_cap_summary_trims_background_first_and_never_the_persons_sections():
+    text = "\n".join([DECISIONS_HEADING, "- keep me", "## Key Decisions", "- and me",
+                      "## Completed Actions", *[f"{n}. old" for n in range(500)],
+                      "## Active State", "- current"])
+    capped = cap_summary(text, 600)
+    assert len(capped) <= 600
+    assert "- keep me" in capped and "- and me" in capped and "- current" in capped
+    assert "\n499. old\n" in capped and "\n0. old\n" not in capped   # newest actions kept
+
+
+def test_key_decisions_are_never_trimmed():
+    """Oct 29 2026: the summarizer files the person's decisions under "Key Decisions" too (at 20:13 on Oct 28: "Voice
+    clone uses local open-source tools only; no upload or third-party service; no spending")."""
+    text = "\n".join(["## Key Decisions", *[f"- decision {n}" for n in range(20)],
+                      "## Active State", "- current", *[f"- detail {n}" for n in range(100)]])
+    capped = cap_summary(text, 600)
+    assert len(capped) <= 600 and "- current" in capped
+    assert all(f"- decision {n}\n" in capped for n in range(20))
+
+
+@pytest.mark.parametrize("decisions,written_part_fits", [(520, True), (700, False)])
+def test_untrimmed_sections_over_the_cap_still_end_with_the_newest_quote_and_the_pointer(decisions,
+                                                                                          written_part_fits):
+    """Oct 29 2026: Zero's summary at 20:13 on Oct 28 was 31,972 characters against its 32,000 cap, and the decisions
+    it never trims grow on every update. Past the cap, the cut at the end took the pointer to the full history first,
+    then the person's newest words. The person's oldest quotes go first now, then the end of the written part."""
+    said = [f"Message {n}: " + "please send the notice from my personal email. " * 6 for n in range(20)]
+    quotes = recent_user_quotes(None, said, _LEAN_USER_MESSAGES_HEADING, lambda text, room: text[:room])
+    pointer = _build_recovery_footer("api_1791377683_cccd3e21", 24)
+    text = "\n".join([
+        "## Historical Task Snapshot", "User asked when Claude Code renews.", "",
+        DECISIONS_HEADING, *[f"- Oct {n % 28 + 1}: a standing decision, carried forward ({n})." for n in range(decisions)],
+        "", "## Key Decisions", "- Voice clone uses local open-source tools only.",
+    ]) + quotes + pointer
+    cap = summary_cap_chars(TRIGGER)
+    assert len(text) > cap
+    capped = cap_summary(text, cap)
+    assert len(capped) <= cap
+    assert capped.startswith("## Historical Task Snapshot\nUser asked when Claude Code renews.")
+    assert capped.endswith(pointer.strip())
+    assert "> Message 19: " in capped and "> Message 0: " not in capped   # newest first; the oldest went
+    assert ("Voice clone uses local open-source tools only." in capped) is written_part_fits
+    assert ("> Message 18: " in capped) is written_part_fits
+
+
+def test_each_compaction_is_logged_for_the_hub(tmp_path):
+    record_compaction({"session_id": "s1", "before_tokens": 165_066, "after_tokens_estimate": 90_000}, home=tmp_path)
+    record_compaction({"session_id": "s1", "before_tokens": 150_000, "after_tokens_estimate": 88_000}, home=tmp_path)
+    lines = [json.loads(line) for line in (tmp_path / "logs" / "compactions.jsonl").read_text().splitlines()]
+    assert [line["before_tokens"] for line in lines] == [165_066, 150_000]
+    assert all(line["at"] > 0 and line["session_id"] == "s1" for line in lines)
+
+
+def test_right_after_a_compaction_the_idle_job_finds_too_little_to_reclaim():
+    """The gateway's idle job used to compact again after the next reply; its own output is not worth compacting."""
+    from gateway.platforms.api_server_idle_compaction import MIN_RECLAIM_RATIO, reclaimable_tokens
+
+    messages = _zero_chat()
+    compressor, compressed = _compress(messages)
+    assert reclaimable_tokens(compressor, messages) >= TRIGGER * MIN_RECLAIM_RATIO
+    assert reclaimable_tokens(compressor, compressed + _turn(99)) < TRIGGER * MIN_RECLAIM_RATIO

diff --git a/tests/agent/test_compaction_quoted_rules.py b/tests/agent/test_compaction_quoted_rules.py
new file mode 100644
index 0000000..d5e6adc
--- /dev/null
+++ b/tests/agent/test_compaction_quoted_rules.py
@@ -0,0 +1,47 @@
+"""A compaction summary keeps the person's rules in their own words and never writes rules of its own (Zero, Nov 1 2026).
+
+Two of Zero's summaries wrote rules Colin never said into "Decisions & Standing Preferences": a scope list for his Mac
+that called "Feel free to use my computer whenever you need to for stuff" not standing permission, and "never log in as
+Colin" from one declined sign-in. The handoff says that section still applies, and each update carried them forward.
+"""
+
+from unittest.mock import patch
+
+from agent.compaction_floor import DECISIONS_HEADING
+from agent.context_compressor import ContextCompressor
+
+
+def _compressor(previous_summary=None):
+    with patch("agent.context_compressor.get_model_context_length", return_value=1_000_000):
+        compressor = ContextCompressor(model="claude-opus-5-5", protect_last_n=30, quiet_mode=True)
+    compressor.threshold_tokens = 200_000
+    compressor._previous_summary = previous_summary
+    return compressor
+
+
+def _decisions_instructions(prompt):
+    return prompt.split(DECISIONS_HEADING + "\n", 1)[1].split("\n\n## ", 1)[0]
+
+
+def test_a_rule_is_the_persons_quoted_dated_words_and_anything_else_is_a_note():
+    text = _decisions_instructions(_compressor()._build_summary_prompt("turns", 2000, None, "", True))
+    assert "as the user's own words in quotes with the date" in text
+    assert "Never write a rule, limit or scope the user did not say" in text
+    assert "never narrow or override a permission the user gave" in text
+    assert "Declining one request is not a standing rule." in text
+    assert "must start with \"Assistant's note:\" and is never a rule" in text
+    assert "what to always or never do" not in text
+    assert "VERBATIM" in text   # security constraints are still quoted word for word
+
+
+def test_an_update_drops_rules_an_earlier_summary_made_up():
+    previous = f"{DECISIONS_HEADING}\n- Mac opens only on a specific Mac request.\n"
+    prompt = _compressor(previous)._build_summary_prompt("turns", 2000, None, "", True)
+    assert f'Carry each quoted, dated line under "{DECISIONS_HEADING}" forward' in prompt
+    assert "came from an earlier summary, not from the user. Drop it if it is a rule, limit or scope" in prompt
+    assert "Carry every item under" not in prompt
+
+
+def test_a_chat_with_no_user_turns_still_invents_no_preferences():
+    text = _decisions_instructions(_compressor()._build_summary_prompt("turns", 2000, None, "", False))
+    assert "Do not invent user preferences." in text

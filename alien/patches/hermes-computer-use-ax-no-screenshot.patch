diff --git a/tests/tools/test_computer_use_ax_no_screenshot.py b/tests/tools/test_computer_use_ax_no_screenshot.py
new file mode 100644
--- /dev/null
+++ b/tests/tools/test_computer_use_ax_no_screenshot.py
@@ -0,0 +1,64 @@
+"""Text-only captures skip pixels only when the installed driver accepts that request."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from tools.computer_use.cua_backend_capture import _CaptureMixin, _gws_is_empty
+
+
+PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a0ioAAAAASUVORK5CYII="
+
+
+class Capture(_CaptureMixin):
+    def __init__(self, supported):
+        self._session = SimpleNamespace(supports_input_property=lambda tool, prop: supported)
+        self._session_id = "test"
+        self._last_app = ""
+        self._snapshot_tokens = {}
+        self.calls = []
+
+    def _gws_args(self):
+        return {"pid": 11, "window_id": 22, "session": "test", "max_elements": 200}
+
+    def _resolve_capture_windows(self, *a):
+        return [{"app_name": "Browser", "pid": 11, "window_id": 22, "z_index": 1, "off_screen": False}]
+
+    def _set_active_target(self, target):
+        self._active_pid, self._active_window_id = target["pid"], target["window_id"]
+
+    def _fetch_or_refetch(self, name, args, *a):
+        self.calls.append((name, args))
+        out = {"structuredContent": {"elements": [{"element_index": 1, "role": "AXTextField", "label": "Full name",
+                "frame": {"x": 10, "y": 20, "w": 100, "h": 30}, "element_token": "s1:1"}]}}
+        if args.get("include_screenshot", True):
+            out["images"] = [PNG]
+        assert not _gws_is_empty(out)
+        return out
+
+
+@pytest.mark.parametrize("supported", [False, True])
+def test_text_capture_preserves_elements_and_tokens(supported):
+    backend = Capture(supported)
+    result = backend.capture("ax", pid=11, window_id=22)
+    assert result.elements[0].label == "Full name"
+    assert result.elements[0].bounds == (10, 20, 100, 30)
+    assert backend._snapshot_tokens == {1: "s1:1"}
+    assert result.ax_max_elements == 200
+    args = backend.calls[0][1]
+    if supported:
+        assert args["include_screenshot"] is False
+        assert result.png_b64 is None
+        assert result.png_bytes_len == 0
+    else:
+        assert "include_screenshot" not in args
+        assert result.png_b64 == PNG
+
+
+@pytest.mark.parametrize("supported", [False, True])
+def test_visual_capture_keeps_its_image(supported):
+    backend = Capture(supported)
+    result = backend.capture("som", pid=11, window_id=22)
+    assert "include_screenshot" not in backend.calls[0][1]
+    assert result.png_b64 == PNG
+    assert result.png_bytes_len > 0

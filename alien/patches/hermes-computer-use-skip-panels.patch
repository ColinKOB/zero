+"""Unqualified Linux captures skip desktop panels and docks (Xfce on the Bot Desktop), which the window manager
+stacks above every normal window: on Oct 9 a capture returned the 88x44 launcher dock instead of the browser."""
+
+from unittest import mock
+
+from tools.computer_use import cua_backend_capture
+from tools.computer_use.cua_backend_capture import _select_capture_target
+
+
+def _window(app_name, title, window_id, z_index):
+    return {"app_name": app_name, "pid": 100 + window_id, "window_id": window_id, "title": title,
+            "off_screen": False, "z_index": z_index}
+
+
+# list_windows on the School Bot Desktop, Oct 9, sorted frontmost first as capture() sorts it.
+DOCK = _window("Xfce4-panel", "xfce4-panel", 6291468, 3)
+TOP_PANEL = _window("Xfce4-panel", "xfce4-panel", 6291459, 2)
+BROWSER = _window("Chromium-browser", "Course | eLearning - Google Chrome for Testing", 10485763, 1)
+DESKTOP = _window("Xfdesktop", "Desktop", 8388648, 0)
+
+
+def test_implicit_linux_capture_picks_the_browser_not_the_dock():
+    with mock.patch.object(cua_backend_capture.sys, "platform", "linux"):
+        target = _select_capture_target([DOCK, TOP_PANEL, BROWSER, DESKTOP], app_requested=False)
+    assert target == BROWSER
+
+
+def test_only_shell_windows_still_capture_something():
+    with mock.patch.object(cua_backend_capture.sys, "platform", "linux"):
+        target = _select_capture_target([DOCK, TOP_PANEL, DESKTOP], app_requested=False)
+    assert target == DOCK
+
+
+def test_asking_for_the_panel_by_name_still_gets_it():
+    with mock.patch.object(cua_backend_capture.sys, "platform", "linux"):
+        target = _select_capture_target([DOCK, BROWSER], app_requested=True)
+    assert target == DOCK

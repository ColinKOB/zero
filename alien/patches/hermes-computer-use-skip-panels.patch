 # Linux/X11 surfaces GNOME Shell / desktop backdrop windows ahead of real app windows with no useful z-order; they
 # are targetable but capture as empty, so default capture skips them.
 _NON_APP_WINDOW_TITLE_PREFIXES = ("@!", "Desktop", "gnome-shell", "GNOME Shell")  # "@!" = GNOME helpers
+# Panels and docks of Linux desktop shells. The window manager stacks them above every normal window, so an
+# unqualified capture on the Bot Desktop (Xfce) picked the 88x44 launcher dock instead of the browser.
+_PANEL_APP_NAMES = frozenset({"xfce4-panel", "plank", "tint2", "polybar", "lxpanel", "lxqt-panel",
+                              "mate-panel", "budgie-panel", "cairo-dock", "latte-dock"})
 
 _ELEMENT_LINE_RE = re.compile(
     r'^\s*(?:-\s+)?\[(\d+)\]\s+(\w+)'
@@ -77,6 +81,8 @@ def _parse_xprop_net_active_window(stdout: str) -> Optional[int]:
 def _is_real_app_window(w: Dict[str, Any]) -> bool:
     """Return False for desktop/shell helper windows that capture as empty."""
     title = w.get("title", "")
+    if str(w.get("app_name", "")).strip().lower() in _PANEL_APP_NAMES or title.strip().lower() in _PANEL_APP_NAMES:
+        return False
     return not any(title.startswith(p) or title.lower().startswith(p.lower()) for p in _NON_APP_WINDOW_TITLE_PREFIXES)
 

+def _port_conflict(e: subprocess.CalledProcessError) -> bool:
+    """docker run refused because a published host port is already taken."""
+    text = f"{e.stderr or ''} {e.stdout or ''}".lower()
+    return "port is already allocated" in text or "address already in use" in text
+
+
+def _without_published_ports(argv: list[str]) -> list[str]:
+    """``argv`` with every ``-p``/``--publish`` option removed."""
+    out, skip = [], False
+    for arg in argv:
+        if skip:
+            skip = False
+            continue
+        if arg in ("-p", "--publish"):
+            skip = True
+            continue
+        if arg.startswith("--publish=") or (arg.startswith("-p") and not arg.startswith("--") and len(arg) > 2
+                                            and arg[2] in "0123456789"):
+            continue
+        out.append(arg)
+    return out

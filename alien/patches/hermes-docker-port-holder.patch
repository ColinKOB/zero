+# Zero, Nov 3 2026: a Zip's preview ports are published on one small holder container per profile
+# ("zip-ports-<profile>"), and every work container of that profile joins the holder's network. Before, the ports
+# went to whichever of the profile's containers started first, and a later one ran without them, so a preview it
+# served never reached the browser (Clients' Thanksgiving preview, problem report 64: the 6-day-old container that
+# held 18210-18219 was idle, and the one serving the page had no published ports).
+_PORT_HOLDER_LABEL = "taffy.port-holder"
+_PUBLISH_FLAGS = ("-p", "--publish")
+# Docker refuses these next to --network container:<name>; a profile that sets one keeps publishing directly.
+_OWN_NETWORK_FLAGS = ("--add-host", "--dns", "--dns-search", "--dns-option", "-h", "--hostname", "--mac-address",
+                      "--network-alias", "--ip", "--ip6", "--expose", "--link")
+_port_holder_lock = threading.Lock()
+
+
+def _port_conflict(text: str) -> bool:
+    """docker run refused because a published host port is already taken."""
+    text = (text or "").lower()
+    return "port is already allocated" in text or "address already in use" in text
+
+
+def _without_published_ports(argv: list[str]) -> list[str]:
+    """``argv`` with every ``-p``/``--publish`` option removed."""
+    out, skip = [], False
+    for arg in argv:
+        if skip:
+            skip = False
+            continue
+        if arg in _PUBLISH_FLAGS:
+            skip = True
+            continue
+        if arg.startswith("--publish="):
+            continue
+        out.append(arg)
+    return out
+
+
+def _port_holder_split(argv: list[str]) -> tuple[list[str], Optional[str], list[str]]:
+    """``(publish_args, network, rest)``: the run args' ``-p`` options, their named network, and the args without
+    either. ``([], None, argv)`` when nothing is published or the container cannot share another's network."""
+    publish, network, rest, i = [], None, [], 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg in _PUBLISH_FLAGS and i + 1 < len(argv):
+            publish += argv[i:i + 2]
+            i += 2
+            continue
+        if arg.startswith("--publish="):
+            publish.append(arg)
+        elif arg in ("--network", "--net") and i + 1 < len(argv):
+            network = argv[i + 1]
+            i += 2
+            continue
+        elif arg.startswith(("--network=", "--net=")):
+            network = arg.split("=", 1)[1]
+        elif arg in _OWN_NETWORK_FLAGS or arg.startswith(tuple(f"{f}=" for f in _OWN_NETWORK_FLAGS)):
+            return [], None, argv
+        else:
+            rest.append(arg)
+        i += 1
+    if not publish or not network or network in ("none", "host") or network.startswith("container:"):
+        return [], None, argv
+    return publish, network, rest
+

+def test_foreground_cancels_idle_summary_and_releases_both_leases(conversation, monkeypatch):
+    from contextlib import nullcontext
+    from gateway.platforms import api_server_idle_compaction as idle
+    from gateway.platforms.api_server import request_hard_interrupt
+    agent, db, history = conversation
+    owner = SimpleNamespace(_profile_scope=lambda profile: nullcontext(),
+        _bind_api_server_session=lambda **kw: None, _create_agent=lambda **kw: agent,
+        _shutdown_interruptible_agents={}, _memory_sessions=SimpleNamespace(checkin=lambda a: None))
+    run, job = idle.IdleSession(agent.session_id, "trace", {}, 1), idle.IdleCompaction()
+    started, release = threading.Event(), threading.Event()
+    before = db.get_messages_as_conversation(agent.session_id)
+    monkeypatch.setattr("agent.turn_context._preflight_request_tokens", lambda *a: 180_000)
+
+    def provider(_):
+        started.set()
+        release.wait(3)
+        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content="late summary"))])
+
+    with patch("agent.context_compressor.call_llm", side_effect=lambda **kw: _run_protected_sync_provider_call(provider, kw)), ThreadPoolExecutor(1) as executor:
+        future = executor.submit(idle._compact, owner, run, job)
+        try:
+            assert started.wait(3)
+            job.cancelled.set()
+            request_hard_interrupt(job.agent, "Foreground turn arrived")
+            future.result(timeout=1)
+            assert db.get_messages_as_conversation(agent.session_id) == before
+            assert db.get_compression_lock_holder(agent.session_id) is None
+            assert agent._active_session_turn_lease_holder is None
+            assert not owner._shutdown_interruptible_agents
+        finally:
+            release.set()
+    assert db.get_messages_as_conversation(agent.session_id) == before

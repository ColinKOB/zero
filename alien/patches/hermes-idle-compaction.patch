+"""Idle admission, foreground priority, and durable compaction ownership."""
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from gateway.platforms import api_server_idle_compaction as idle
+
+
+def agent():
+    return SimpleNamespace(
+        compression_enabled=True, api_mode="chat_completions", _cached_system_prompt="saved prefix",
+        context_compressor=SimpleNamespace(threshold_tokens=200_000, last_compression_rough_tokens=0,
+            awaiting_real_usage_after_compression=False, get_active_compression_failure_cooldown=lambda: None))
+
+
+def run():
+    return SimpleNamespace(session_id="owned", request_profile="trace", session_history_delivery=True,
+        agent_kwargs={}, idle_compaction_generation=1)
+
+
+def owner():
+    return SimpleNamespace(_run_shutdown_requested_at=None)
+
+
+@pytest.mark.parametrize("tokens,expected", [(169_999, None), (170_000, 170_000), (199_999, 199_999)])
+def test_near_threshold_uses_same_pressure_estimator(monkeypatch, tokens, expected):
+    monkeypatch.setattr("agent.turn_context._preflight_request_tokens", lambda *a: tokens)
+    assert idle.eligible(agent(), []) == expected
+
+
+def test_cooldown_checkpoint_and_no_growth_skip(monkeypatch):
+    monkeypatch.setattr("agent.turn_context._preflight_request_tokens", lambda *a: 180_000)
+    a = agent()
+    a.context_compressor.last_compression_rough_tokens = 170_000
+    assert idle.eligible(a, []) is None
+    a.context_compressor.last_compression_rough_tokens = 0
+    a.context_compressor.awaiting_real_usage_after_compression = True
+    assert idle.eligible(a, []) is None
+    a.context_compressor.awaiting_real_usage_after_compression = False
+    a.context_compressor.get_active_compression_failure_cooldown = lambda: {"until": 99}
+    assert idle.eligible(a, []) is None
+
+
+@pytest.mark.asyncio
+async def test_foreground_cancels_before_idle_worker_starts(monkeypatch):
+    from gateway.platforms.api_server import _api_request_profile
+    o, r = owner(), run()
+    token = _api_request_profile.set("trace")
+    compact = Mock()
+    monkeypatch.setattr(idle, "eligible", lambda *a: 180_000)
+    monkeypatch.setattr(idle, "_compact", compact)
+    try:
+        assert await idle.foreground(o, "owned") == 1
+        idle.schedule(o, r, agent(), {"messages": []})
+        assert len(o._idle_compactions) == 1
+        assert await idle.foreground(o, "owned") == 2
+        compact.assert_not_called()
+        assert not o._idle_compactions
+        idle.schedule(o, r, agent(), {"messages": []})
+        assert not o._idle_compactions
+    finally:
+        _api_request_profile.reset(token)
+
+
+@pytest.mark.asyncio
+async def test_foreground_joins_active_worker_before_return(monkeypatch):
+    from gateway.platforms.api_server import _api_request_profile
+    o, r = owner(), run()
+    monkeypatch.setattr(idle, "IDLE_SECONDS", 0.001)
+    monkeypatch.setattr(idle, "eligible", lambda *a: 180_000)
+    started = asyncio.Event()
+    finished = asyncio.Event()
+
+    async def execute(o, r, j, key):
+        started.set()
+        await j.wake.wait()
+        assert j.cancelled.is_set()
+        finished.set()
+        o._idle_compactions.pop(key)
+    monkeypatch.setattr(idle, "_idle", execute)
+    token = _api_request_profile.set("trace")
+    try:
+        await idle.foreground(o, "owned")
+        idle.schedule(o, r, agent(), {"messages": []})
+        await started.wait()
+        await idle.foreground(o, "owned")
+        assert finished.is_set()
+    finally:
+        _api_request_profile.reset(token)
+
+
+@pytest.mark.asyncio
+async def test_session_turn_joins_idle_before_loading_history_and_schedules_after_reply():
+    from unittest.mock import MagicMock, patch
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+    events = []
+    history = [{"role": "assistant", "content": "Fresh compacted history"}]
+    result = {"final_response": "Rice recipe", "messages": history}
+    a = MagicMock()
+    a.run_conversation.side_effect = lambda **kw: events.append("model") or result
+
+    async def foreground(owner, sid):
+        events.append("cancel")
+        return 7
+
+    async def load(sid):
+        events.append("load")
+        return history
+
+    with (patch.object(idle, "foreground", side_effect=foreground),
+          patch.object(idle, "schedule") as scheduled,
+          patch.object(adapter, "_create_agent", return_value=a),
+          patch.object(adapter, "_conversation_history_for_session", side_effect=load),
+          patch.object(adapter, "_finish_turn_result", return_value=(result, {}))):
+        out, _ = await adapter._run_agent(user_message="Rice", conversation_history=[],
+            session_id="owned", idle_compaction=True, requested_provider="openai-compat", requested_model="test/model")
+    assert out is result
+    assert events == ["cancel", "load", "model"]
+    assert a.run_conversation.call_args.kwargs["conversation_history"] is history
+    session = scheduled.call_args.args[1]
+    assert session.idle_compaction_generation == 7
+    assert session.agent_kwargs["requested_model"] == "test/model"
+    assert scheduled.call_args.args[2] is a

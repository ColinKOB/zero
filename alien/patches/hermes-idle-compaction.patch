+++ b/tests/agent/test_compaction_foreground_priority.py
@@ -0,0 +1,161 @@
+"""User input cancels a summary candidate without consuming its queued message."""
+
+import copy
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from agent.auxiliary_client import _run_protected_sync_provider_call
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def conversation(tmp_path):
+    from run_agent import AIAgent
+    db = SessionDB(db_path=tmp_path / "state.db")
+    sid = "owned-compaction-test"
+    db.create_session(sid, source="api_server", system_prompt="saved prefix")
+    agent = AIAgent(api_key="test", base_url="https://example.test/v1", model="test/model",
+                    quiet_mode=True, session_db=db, session_id=sid,
+                    skip_context_files=True, skip_memory=True)
+    agent._compression_feasibility_checked = True
+    agent._cached_system_prompt = "saved prefix"
+    agent._retain_seeded_system_prompt = True
+    agent.context_compressor.threshold_tokens = 200_000
+    agent.context_compressor._resolved_context_length = 1_000_000
+    for i in range(40):
+        db.append_message(sid, "user" if i % 2 == 0 else "assistant", f"turn {i} " + "rice recipe notes " * 200)
+    history = db.get_messages_as_conversation(sid, include_row_ids=True)
+    yield agent, db, history
+    agent.release_clients()
+    db.close()
+
+
+@pytest.mark.parametrize("kind", ["steer", "typed", "stop"])
+def test_summary_yields_and_late_provider_cannot_commit(conversation, kind):
+    from gateway.platforms.api_server import request_hard_interrupt
+    agent, db, history = conversation
+    before = copy.deepcopy(db.get_messages_as_conversation(agent.session_id))
+    started, release = threading.Event(), threading.Event()
+    correction = "No, not fried chicken. fried rice"
+
+    def provider(_):
+        started.set()
+        release.wait(3)
+        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content="Recipe context preserved. " * 80))])
+
+    def summary(**kwargs):
+        return _run_protected_sync_provider_call(provider, kwargs)
+
+    with patch("agent.context_compressor.call_llm", side_effect=summary), ThreadPoolExecutor(1) as executor:
+        future = executor.submit(agent._compress_context, history, "saved prefix", approx_tokens=205_000)
+        try:
+            assert started.wait(3)
+            t0 = time.monotonic()
+            if kind == "stop":
+                request_hard_interrupt(agent, "Stop requested via API")
+            elif kind == "typed":
+                agent.interrupt(correction)
+            else:
+                assert agent.steer(correction)
+            messages, prompt = future.result(timeout=1)
+            assert time.monotonic() - t0 < 1
+            assert messages == history
+            assert prompt == "saved prefix"
+            assert db.get_messages_as_conversation(agent.session_id) == before
+            assert db.get_compression_lock_holder(agent.session_id) is None
+            if kind == "steer":
+                assert agent._drain_pending_steer() == correction
+                assert agent._drain_pending_steer() is None
+            elif kind == "typed":
+                assert agent._interrupt_message == correction
+            assert db.get_session(agent.session_id)["system_prompt"] == "saved prefix"
+        finally:
+            release.set()
+    assert db.get_messages_as_conversation(agent.session_id) == before
+
+
+def test_deferred_summary_does_not_reenter_until_next_turn(conversation):
+    agent, _, history = conversation
+    agent._compression_deferred_for_input = True
+    with patch("agent.conversation_compression.compress_context") as compact:

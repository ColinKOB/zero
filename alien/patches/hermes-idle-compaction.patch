diff --git a/gateway/platforms/api_server_idle_compaction.py b/gateway/platforms/api_server_idle_compaction.py
new file mode 100644
index 0000000..35c32ad
--- /dev/null
+++ b/gateway/platforms/api_server_idle_compaction.py
@@ -0,0 +1,181 @@
+"""Between-turn compaction for durable API runs, with foreground priority.
+
+The event loop owns the job registry and admission generations. A worker owns a
+fresh agent and both durable leases. Foreground admission cancels the candidate
+and joins its owner before loading history, so neither a stale summary nor stale
+caller history can overwrite the next turn.
+"""
+
+import asyncio
+import logging
+import threading
+import uuid
+from dataclasses import dataclass, field
+
+logger = logging.getLogger("gateway.platforms.api_server")
+IDLE_SECONDS = 5.0
+TRIGGER_RATIO = 0.85
+
+
+@dataclass
+class IdleSession:
+    session_id: str
+    request_profile: object
+    agent_kwargs: dict
+    idle_compaction_generation: int
+    session_history_delivery: bool = True
+    gateway_session_key: str = ""
+
+
+@dataclass
+class IdleCompaction:
+    cancelled: threading.Event = field(default_factory=threading.Event)
+    wake: asyncio.Event = field(default_factory=asyncio.Event)
+    task: object = None
+    agent: object = None
+
+
+def _state(owner):
+    return vars(owner).setdefault("_idle_compactions", {}), vars(owner).setdefault("_idle_compaction_generations", {})
+
+
+def _key(profile, session_id):
+    return str(profile or ""), str(session_id)
+
+
+def busy(owner, profile, session_id):
+    return _key(profile, session_id) in _state(owner)[0]
+
+
+async def foreground(owner, session_id):
+    from gateway.platforms.api_server import _api_request_profile
+    jobs, generations = _state(owner)
+    key = _key(_api_request_profile.get(), session_id)
+    generation = generations[key] = generations.get(key, 0) + 1
+    job = jobs.get(key)
+    if job is not None:
+        job.cancelled.set()
+        job.wake.set()
+        if job.agent is not None:
+            from gateway.platforms.api_server import request_hard_interrupt
+            await asyncio.to_thread(request_hard_interrupt, job.agent, "Foreground turn arrived")
+        await asyncio.shield(job.task)
+    return generation
+
+
+def eligible(agent, messages):
+    from agent.turn_context import _preflight_request_tokens
+    compressor = getattr(agent, "context_compressor", None)
+    if (not getattr(agent, "compression_enabled", False) or compressor is None
+            or getattr(agent, "_persist_disabled", False)
+            or not getattr(agent, "compression_in_place", True)
+            or getattr(agent, "api_mode", "") == "codex_app_server"
+            or getattr(compressor, "awaiting_real_usage_after_compression", False)):
+        return None
+    threshold = compressor.threshold_tokens
+    pressure = _preflight_request_tokens(agent, messages, agent._cached_system_prompt or "")
+    last = getattr(compressor, "last_compression_rough_tokens", 0) or 0
+    if (pressure < threshold * TRIGGER_RATIO or pressure <= last * 1.10
+            or compressor.get_active_compression_failure_cooldown()):
+        return None
+    return pressure
+
+
+def schedule(owner, run, agent, result):
+    if (not isinstance(result, dict) or not run.session_history_delivery or run.agent_kwargs.get("room_dispatch")
+            or result.get("error") or result.get("partial") or result.get("pending_steer")
+            or result.get("interrupted") or result.get("failed")):
+        return
+    try:
+        pressure = eligible(agent, result.get("messages") or [])
+        if pressure is None:
+            return
+        jobs, generations = _state(owner)
+        key = _key(run.request_profile, run.session_id)
+        if generations.get(key) != run.idle_compaction_generation or key in jobs:
+            return
+        if getattr(owner, "_run_shutdown_requested_at", None) is not None:
+            return
+        job = jobs[key] = IdleCompaction()
+        job.task = asyncio.create_task(_idle(owner, run, job, key))
+    except Exception:
+        logger.warning("Could not schedule idle compaction", exc_info=True)
+
+
+async def _idle(owner, run, job, key):
+    from gateway.platforms.api_server_runs import _submit_api_worker
+    try:
+        try:
+            await asyncio.wait_for(job.wake.wait(), timeout=IDLE_SECONDS)
+        except asyncio.TimeoutError:
+            pass
+        if (job.cancelled.is_set() or getattr(owner, "_run_shutdown_requested_at", None) is not None):
+            return
+        await _submit_api_worker(asyncio.get_running_loop(), lambda: _compact(owner, run, job))
+    except Exception:
+        logger.warning("Idle compaction failed for session %s", run.session_id, exc_info=True)
+    finally:
+        jobs, _ = _state(owner)
+        if jobs.get(key) is job:
+            jobs.pop(key, None)
+
+
+def _compact(owner, run, job):
+    from agent.aux_accounting import reset_accounting_context, set_accounting_context
+    from agent.conversation_loop import _restore_or_build_system_prompt
+    from agent.turn_facade_lease import DurableTurnLease, LEASE_TTL_SECONDS
+    from gateway.session_context import clear_session_vars
+    from hermes_state_pidns import holder_namespace_token
+    import os
+
+    agent = lease = tokens = acct_token = None
+    with owner._profile_scope(run.request_profile):
+        try:
+            if job.cancelled.is_set():
+                return
+            tokens = owner._bind_api_server_session(
+                chat_id=run.session_id, session_key=run.gateway_session_key or run.session_id,
+                session_id=run.session_id, profile=run.request_profile or "", session_history_delivery="1")
+            agent = owner._create_agent(**run.agent_kwargs)
+            job.agent = agent
+            owner._shutdown_interruptible_agents[id(agent)] = agent
+            db = agent._session_db
+            if (job.cancelled.is_set() or db is None
+                    or getattr(owner, "_run_shutdown_requested_at", None) is not None):
+                return
+            holder = f"pid={os.getpid()}{holder_namespace_token()}:idle={uuid.uuid4().hex}"
+            if not db.acquire_session_turn_lease(
+                    run.session_id, holder, ttl_seconds=LEASE_TTL_SECONDS,
+                    wait_seconds=0, should_abort=job.cancelled.is_set):
+                return
+            acct_token = set_accounting_context(db, run.session_id)
+            lease = DurableTurnLease(agent, db, run.session_id, holder)
+            agent._active_session_turn_lease_holder = holder
+            agent._active_session_turn_lease_ttl_seconds = LEASE_TTL_SECONDS
+            lease.start()
+            history = db.get_messages_as_conversation(run.session_id, repair_alternation=True, include_row_ids=True)
+            from agent.usage_anchor import restore_usage_anchor
+            restore_usage_anchor(agent, history)
+            _restore_or_build_system_prompt(agent, None, history)
+            # Keep the saved system/tools prefix. Only the history boundary changes.
+            agent._retain_seeded_system_prompt = True
+            pressure = eligible(agent, history)
+            if pressure is None or job.cancelled.is_set():
+                return
+            logger.info("Idle compaction: session=%s pressure=%d trigger=%d", run.session_id,
+                        pressure, agent.context_compressor.threshold_tokens)
+            agent._compress_context(history, agent._cached_system_prompt or "",
+                                    approx_tokens=pressure, task_id=run.session_id, trigger="idle")
+        finally:
+            if lease is not None:
+                lease.stop_refresher()
+                lease.join_threads()
+                lease.release()
+            if agent is not None:
+                owner._shutdown_interruptible_agents.pop(id(agent), None)
+                owner._memory_sessions.checkin(agent)
+                agent.release_clients()
+            if tokens:
+                clear_session_vars(tokens)
+            if acct_token is not None:
+                reset_accounting_context(acct_token)

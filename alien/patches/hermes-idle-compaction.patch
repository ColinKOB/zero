+def test_idle_worker_commits_with_saved_prefix_and_releases_turn(conversation, monkeypatch):
+    from contextlib import nullcontext
+    from gateway.platforms import api_server_idle_compaction as idle
+    agent, db, history = conversation
+    sid = agent.session_id
+    owner = SimpleNamespace(_profile_scope=lambda profile: nullcontext(),
+        _bind_api_server_session=lambda **kw: None, _create_agent=lambda **kw: agent,
+        _shutdown_interruptible_agents={}, _memory_sessions=SimpleNamespace(checkin=lambda a: None))
+    run = idle.IdleSession(sid, "trace", {}, 1)
+    monkeypatch.setattr("agent.turn_context._preflight_request_tokens", lambda *a: 180_000)
+    summary = SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content="Rice recipe context. " * 100))])
+    def summarize(**kwargs):

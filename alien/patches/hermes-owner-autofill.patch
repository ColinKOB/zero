@@ -0,0 +1,226 @@
+"""Bound browser writes for an explicit human selection. The gateway owns admission and redaction.
+
+A unique isolated-world context pins a prepared form to one document. Secret-bearing CDP messages
+use an unregistered, silent transport logger and never pass through a subprocess or browser tool result.
+"""
+from __future__ import annotations
+
+import contextlib
+import json
+import logging
+import secrets
+import time
+import urllib.request
+from dataclasses import dataclass
+from string import Template
+from urllib.parse import urlsplit
+
+
+class Refused(Exception):
+    """Only a bounded reason code can cross the control socket, including for an unexpected exception."""
+    def __init__(self, code: str):
+        allowed = {"control_required", "unavailable", "choice_required", "control_changed", "choice_expired",
+                   "login_removed", "login_unavailable", "page_changed", "fill_uncertain", "open_page",
+                   "browser_unavailable", "form_changed", "focus_form", "no_fields"}
+        self.code = code if code in allowed else "unavailable"
+        super().__init__(self.code)
+
+
+@dataclass(frozen=True)
+class Page:
+    target: str
+    frame: str
+    loader: str
+    origin: str
+
+
+@dataclass(frozen=True)
+class Prepared:
+    page: Page
+    session: str
+    context: int
+    nonce: str
+    fields: list[dict]
+
+    @property
+    def password(self):
+        return any(field["value_key"] == "password" for field in self.fields)
+
+
+_TRANSPORT_LOG = logging.Logger("owner-vault-private-transport", level=logging.CRITICAL + 1)
+_TRANSPORT_LOG.addHandler(logging.NullHandler())
+_TRANSPORT_LOG.propagate = False
+
+
+class Browser:
+    def __enter__(self):
+        from tools.bot_desktop import browser
+        from websockets.sync.client import connect
+        port = browser.running_instance_cdp_port(str(browser.profile_dir()))
+        if port is None:
+            raise Refused("open_page")
+        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+        with opener.open(f"http://127.0.0.1:{port}/json/version", timeout=3) as response:
+            endpoint = json.loads(response.read(65536))["webSocketDebuggerUrl"]
+        parsed = urlsplit(endpoint)
+        if parsed.scheme != "ws" or parsed.hostname not in ("127.0.0.1", "localhost") or parsed.port != port:
+            raise Refused("browser_unavailable")
+        self.ws = connect(endpoint, proxy=None, open_timeout=3, close_timeout=1,
+                          compression=None, logger=_TRANSPORT_LOG, max_size=1024 * 1024)
+        self.navigations = set()
+        self.dead_contexts = set()
+        self.cleared_sessions = set()
+        self.sequence = 0
+        self.deadline = time.monotonic() + 8
+        return self
+
+    def __exit__(self, *_):
+        with contextlib.suppress(Exception):
+            self.ws.close()
+
+    def call(self, method, params=None, session=None):
+        self.sequence += 1
+        request = {"id": self.sequence, "method": method, "params": params or {}}
+        if session:
+            request["sessionId"] = session
+        self.ws.send(json.dumps(request))
+        while time.monotonic() < self.deadline:
+            reply = json.loads(self.ws.recv(timeout=min(3, self.deadline - time.monotonic())))
+            if reply.get("id") != self.sequence:
+                event, body, scope = reply.get("method"), reply.get("params", {}), reply.get("sessionId")
+                if event in ("Page.frameRequestedNavigation", "Page.frameScheduledNavigation", "Page.frameStartedLoading"):
+                    self.navigations.add((scope, body.get("frameId")))
+                if event == "Runtime.executionContextDestroyed":
+                    self.dead_contexts.add(body.get("executionContextId"))
+                if event == "Runtime.executionContextsCleared":
+                    self.cleared_sessions.add(scope)
+                continue
+            if "error" in reply:
+                raise Refused("page_changed")
+            return reply.get("result", {})
+        raise Refused("browser_unavailable")
+
+    def evaluate(self, session, context, expression):
+        result = self.call("Runtime.evaluate", {"expression": expression, "contextId": context,
+                                               "returnByValue": True}, session)
+        if "exceptionDetails" in result:
+            raise Refused("form_changed")
+        value = result.get("result", {}).get("value")
+        return json.loads(value) if isinstance(value, str) else value
+
+    def attach(self, target):
+        return self.call("Target.attachToTarget", {"targetId": target, "flatten": True})["sessionId"]
+
+    def world(self, session, frame, name):
+        return self.call("Page.createIsolatedWorld", {"frameId": frame, "worldName": name}, session)["executionContextId"]
+
+    def snapshot(self) -> Page:
+        found = []
+        targets = self.call("Target.getTargets").get("targetInfos", [])
+        for target in targets:
+            if target.get("type") != "page":
+                continue
+            session = self.attach(target["targetId"])
+            try:
+                frame = self.call("Page.getFrameTree", session=session)["frameTree"]["frame"]
+                context = self.world(session, frame["id"], "zero-owner-probe")
+                visible = self.evaluate(session, context,
+                    "({visible:document.visibilityState==='visible' && document.hasFocus(),origin:location.origin})")
+                if visible.get("visible"):
+                    origin = str(visible.get("origin") or "")
+                    parsed = urlsplit(origin)
+                    if parsed.scheme in ("http", "https") and parsed.hostname:
+                        found.append(Page(target["targetId"], frame["id"], frame["loaderId"], origin))
+            finally:
+                self.call("Target.detachFromTarget", {"sessionId": session})
+        if len(found) != 1:
+            raise Refused("focus_form")
+        return found[0]
+
+    def prepare(self, expected: Page, identifier_type: str) -> Prepared:
+        from agent.vault_login_classifier import LoginControl, build_inspection_js, classify_login_control
+        if self.snapshot() != expected:
+            raise Refused("page_changed")
+        session = self.attach(expected.target)
+        self.call("Page.enable", session=session)
+        self.call("Runtime.enable", session=session)
+        nonce = secrets.token_hex(16)
+        context = self.world(session, expected.frame, "zero-owner-fill")
+        frame = self.call("Page.getFrameTree", session=session)["frameTree"]["frame"]
+        if frame.get("id") != expected.frame or frame.get("loaderId") != expected.loader:
+            raise Refused("page_changed")
+        raw = self.evaluate(session, context, build_inspection_js(nonce))
+        classified = [item for control in raw
+                      if (item := classify_login_control(LoginControl.from_dict(control))) is not None]
+        passwords = sorted((item for item in classified if item.token == "current-password"),
+                           key=lambda item: (-item.score, item.control.index))
+        password = passwords[0] if passwords else None
+        tokens = {"phone": {"tel"}, "email": {"email", "username"}}.get(identifier_type, {"username", "email"})
+        usernames = sorted((item for item in classified if item.token in tokens and
+                            (password is None or item.control.form_index == password.control.form_index)),
+                           key=lambda item: (-item.score, item.control.index))
+        fields = []
+        if usernames:
+            item = usernames[0]
+            fields.append({"index": item.control.index, "token": item.token, "value_key": "username"})
+        if password:
+            fields.append({"index": password.control.index, "token": "current-password", "value_key": "password"})
+        if not fields:
+            raise Refused("no_fields")
+        return Prepared(expected, session, context, nonce, fields)
+
+    def assert_document(self, prepared: Prepared):
+        if prepared.context in self.dead_contexts or prepared.session in self.cleared_sessions or \
+                (prepared.session, prepared.page.frame) in self.navigations:
+            raise Refused("page_changed")
+
+    def write(self, prepared: Prepared, values: dict[str, str]) -> list[str]:
+        self.assert_document(prepared)
+        from agent.vault_login_classifier import build_fill_js
+        shape = [{"index": field["index"], "token": field["token"],
+                  "value": prepared.nonce + ":" + field["value_key"]} for field in prepared.fields]
+        script = build_fill_js(shape, expected_origin=prepared.page.origin, nonce=prepared.nonce)
+        for field in prepared.fields:
+            placeholder = json.dumps(prepared.nonce + ":" + field["value_key"])
+            if script.count(placeholder) != 1:
+                raise Refused("form_changed")
+            script = script.replace(placeholder, "values." + field["value_key"])
+        expression = Template("""(() => {
+          if(location.origin !== $origin) return {refused:true};
+          const values = $values, fields = $fields, nonce = $nonce;
+          const records = fields.map(f => {
+            const el=document.querySelector('[data-hermes-vault-slot="'+nonce+':'+f.index+'"]');
+            return el ? {el, before:f.value_key==='password' ? '' : el.value, ours:values[f.value_key]} : null;
+          }).filter(Boolean);
+          globalThis[$nonce] = records;
+          return $script;
+        })()""").substitute(origin=json.dumps(prepared.page.origin), values=json.dumps(values),
+                           fields=json.dumps(prepared.fields), nonce=json.dumps(prepared.nonce), script=script)
+        result = self.evaluate(prepared.session, prepared.context, expression)
+        if isinstance(result, str):
+            result = json.loads(result)
+        if not isinstance(result, dict) or result.get("refused") or result.get("filled") != len(prepared.fields):
+            raise Refused("form_changed")
+        return [field["value_key"] for field in prepared.fields]
+
+    def rollback(self, prepared: Prepared) -> bool:
+        expression = Template("""(() => {
+          if(location.origin !== $origin) return false;
+          if(!Object.hasOwn(globalThis,$nonce)) return false;
+          const records=globalThis[$nonce];
+          for(const {el,before,ours} of records) {
+            if(el.isConnected && el.value===ours) {
+              const set=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;
+              set.call(el,before);el.dispatchEvent(new Event('input',{bubbles:true}));
+            }
+          }
+          delete globalThis[$nonce];
+          document.querySelectorAll('[data-hermes-vault-slot]').forEach(el=>el.removeAttribute('data-hermes-vault-slot'));
+          return true;
+        })()""").substitute(origin=json.dumps(prepared.page.origin), nonce=json.dumps(prepared.nonce))
+        return self.evaluate(prepared.session, prepared.context, expression) is True
+
+    def commit(self, prepared: Prepared):
+        self.assert_document(prepared)
+        self.evaluate(prepared.session, prepared.context, "delete globalThis[" + json.dumps(prepared.nonce) + "]; true")
+        self.assert_document(prepared)

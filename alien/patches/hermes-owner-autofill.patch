@@ -0,0 +1,166 @@
+"""One human-selected login fill, inside the gateway that owns the profile's redaction memory.
+
+This control-socket verb is not a model tool. The ordinary browser_vault_fill path keeps its
+agent-only lease fence. No secret is accepted from, or returned to, the socket caller.
+"""
+from __future__ import annotations
+
+import contextlib
+import secrets
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from tools.browser_owner_fill import Browser, Page, Refused
+
+VIEWER = "taffy-app"
+
+
+@dataclass(frozen=True)
+class Control:
+    holder: str
+    viewer: str
+    since: float
+
+
+@dataclass(frozen=True)
+class Choice:
+    home: str
+    source: str
+    handle: str
+    page: Page
+    control: Control
+    expires: float
+
+
+def current_control(home: Path) -> Control:
+    from tools.bot_desktop import lease
+    value = lease.get(str(home))
+    if value.holder != lease.HUMAN or value.viewer_id != VIEWER:
+        raise Refused("control_required")
+    return Control(value.holder, value.viewer_id, value.since)
+
+
+def matches(meta: Any, origin: str) -> bool:
+    from tools.browser_vault_tool import _same_login_site
+    allowed = list(meta.allowed_origins) or ([str(meta.origin)] if meta.origin else [])
+    return meta.kind == "login" and bool(allowed) and (origin in allowed or _same_login_site(origin, allowed))
+
+
+class OwnerVault:
+    def __init__(self, runner):
+        self.runner = runner
+        self.choices: dict[str, Choice] = {}
+        self.lock = threading.Lock()
+
+    def homes(self) -> dict[str, Path]:
+        from hermes_constants import get_process_hermes_home
+        return {"default": Path(get_process_hermes_home()),
+                **{str(name): Path(home) for name, home in (getattr(self.runner, "_served_profile_homes", None) or {}).items()}}
+
+    def __call__(self, params: dict) -> dict:
+        try:
+            from gateway.run import _profile_runtime_scope
+            from hermes_constants import hermes_home_key
+            if params.get("action") == "probe":
+                return {"available": True}
+            homes = self.homes()
+            requested = hermes_home_key(str(params.get("home") or ""))
+            home = next((h for h in homes.values() if hermes_home_key(h) == requested), None)
+            if home is None:
+                raise Refused("unavailable")
+            # Owner requests serialize inspection and rollback. Agent tools do not use this lock.
+            with self.lock, _profile_runtime_scope(home, hydrate_secrets=False):
+                control = current_control(home)
+                if params.get("action") == "list":
+                    return self.list(home, homes, control)
+                if params.get("action") == "fill":
+                    return self.fill(home, homes, control, str(params.get("choice") or ""))
+                raise Refused("choice_required")
+        except Refused as exc:
+            return {"ok": False, "code": exc.code}
+        except Exception:
+            # Scope setup and browser errors can include credential bytes. None of that text crosses the socket.
+            return {"ok": False, "code": "unavailable"}
+
+    def list(self, home: Path, homes: dict[str, Path], control: Control) -> dict:
+        from agent.vault_store import VaultStore
+        now = time.monotonic()
+        self.choices = {key: value for key, value in self.choices.items() if value.expires > now and value.home != str(home)}
+        with Browser() as browser:
+            page = browser.snapshot()
+        rows = []
+        for profile, source in homes.items():
+            for meta in VaultStore(base_dir=source / "vault").list_items():
+                if matches(meta, page.origin):
+                    rows.append((source != home, meta.label.endswith("(sign-in page)"),
+                                 str(meta.created_at), profile, source, meta))
+        rows.sort(key=lambda row: row[2], reverse=True)
+        rows.sort(key=lambda row: (row[0], row[1]))
+        items, seen = [], set()
+        for other, _, _, profile, source, meta in rows:
+            identity = (meta.identifier or "").strip().casefold() or meta.id
+            if identity in seen:
+                continue
+            seen.add(identity)
+            key = secrets.token_urlsafe(24)
+            self.choices[key] = Choice(str(home), str(source), meta.id, page, control, now + 90)
+            items.append({"id": key, "label": meta.label, "username": meta.identifier or "",
+                          "profile": profile, "own": not other})
+        if current_control(home) != control:
+            raise Refused("control_changed")
+        items.sort(key=lambda item: (not item["own"], item["label"].lower(), item["username"].casefold()))
+        return {"ok": True, "origin": page.origin, "items": items}
+
+    def fill(self, home: Path, homes: dict[str, Path], control: Control, key: str) -> dict:
+        from agent.redact import register_vault_redaction_value
+        from agent.vault_store import VaultStore
+        choice = self.choices.get(key)
+        if choice is None or choice.home != str(home) or choice.expires <= time.monotonic():
+            raise Refused("choice_expired")
+        self.choices.pop(key)
+        if control != choice.control:
+            raise Refused("control_changed")
+        if choice.source not in {str(h) for h in homes.values()}:
+            raise Refused("login_removed")
+        store = VaultStore(base_dir=Path(choice.source) / "vault")
+        meta = store.get_meta(choice.handle)
+        if meta is None or not matches(meta, choice.page.origin):
+            raise Refused("login_removed")
+        started = False
+        with Browser() as browser:
+            prepared = browser.prepare(choice.page, meta.identifier_type or "username")
+            try:
+                values = {"username": meta.identifier or ""}
+                if prepared.password:
+                    password = store.resolve_secret(choice.handle).get("password")
+                    if not isinstance(password, str) or not password:
+                        raise Refused("login_unavailable")
+                    register_vault_redaction_value(password)
+                    values["password"] = password
+                if current_control(home) != control:
+                    raise Refused("control_changed")
+                started = True
+                fields = browser.write(prepared, values)
+                if current_control(home) != control:
+                    raise Refused("control_changed")
+                if browser.snapshot() != choice.page:
+                    raise Refused("page_changed")
+                if current_control(home) != control:
+                    raise Refused("control_changed")
+                browser.commit(prepared)
+                if current_control(home) != control:
+                    raise Refused("control_changed")
+                return {"ok": True, "origin": choice.page.origin, "fields": fields}
+            except Exception as exc:
+                restored = False
+                with contextlib.suppress(Exception):
+                    restored = browser.rollback(prepared)
+                safe = exc.code if isinstance(exc, Refused) else "fill_uncertain"
+                return {"ok": False, "code": safe, "may_have_filled": started and not restored}
+
+
+def owner_vault_verb(runner):
+    return OwnerVault(runner)

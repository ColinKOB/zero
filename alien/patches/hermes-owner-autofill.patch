@@ -0,0 +1,286 @@
+"""Owner fills retain the agent fence and redact before a browser can expose a credential."""
+import contextlib
+import importlib.util
+import io
+import json
+import logging
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+SOURCE = Path(__file__).resolve().parents[1]
+for name, file in (("tools.browser_owner_fill", SOURCE / "tools/browser_owner_fill.py"),
+                   ("gateway.owner_vault", SOURCE / "gateway/owner_vault.py")):
+    spec = importlib.util.spec_from_file_location(name, file)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+
+from gateway import owner_vault as owner
+from tools.browser_owner_fill import Page, Prepared, Refused, _TRANSPORT_LOG
+from agent import redact
+from agent.vault_store import VaultStore
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from tools.bot_desktop import lease
+
+FAKE = 'only-a-fake-login__NONCE__FILL東京'
+PAGE = Page("tab-1", "frame-1", "document-1", "https://example.com")
+
+
+@contextlib.contextmanager
+def scoped(home, **_):
+    token = set_hermes_home_override(str(home))
+    try:
+        yield
+    finally:
+        reset_hermes_home_override(token)
+
+
+class FakeBrowser:
+    page = PAGE
+    after_write = None
+    fail_write = False
+    fail_commit = False
+    rollback_ok = True
+    writes = 0
+    rollbacks = 0
+    registered_first = False
+
+    def __enter__(self): return self
+    def __exit__(self, *_): pass
+    def snapshot(self): return self.page
+    def prepare(self, expected, _):
+        if self.page != expected:
+            raise Refused("page_changed")
+        return Prepared(expected, "session", 42, "nonce", [{"index": 0, "token": "current-password", "value_key": "password"}])
+    def write(self, prepared, values):
+        type(self).writes += 1
+        type(self).registered_first = values["password"] not in redact.redact_registered_vault_values(values["password"])
+        if self.after_write:
+            self.after_write()
+        if self.fail_write:
+            raise RuntimeError(FAKE)
+        return ["password"]
+    def rollback(self, _):
+        type(self).rollbacks += 1
+        return self.rollback_ok
+    def commit(self, _):
+        if self.fail_commit:
+            raise RuntimeError(FAKE)
+
+
+class OwnerFill(unittest.TestCase):
+    def setUp(self):
+        from gateway import run
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.a, self.b = self.root / "profiles/a", self.root / "profiles/b"
+        self.runner = SimpleNamespace(_served_profile_homes={"a": self.a, "b": self.b})
+        self.handler = owner.OwnerVault(self.runner)
+        for patch in (mock.patch("hermes_constants.get_process_hermes_home", return_value=self.root),
+                      mock.patch.object(run, "_profile_runtime_scope", scoped),
+                      mock.patch.object(owner, "Browser", FakeBrowser)):
+            patch.start(); self.addCleanup(patch.stop)
+        for key, value in {"page": PAGE, "after_write": None, "fail_write": False, "fail_commit": False,
+                           "rollback_ok": True, "writes": 0, "rollbacks": 0, "registered_first": False}.items():
+            setattr(FakeBrowser, key, value)
+        self.meta = VaultStore(base_dir=self.a / "vault").add_item("login", "Example",
+            {"identifier": "person@example.com", "identifier_type": "email", "password": FAKE}, origin=PAGE.origin)
+        lease.acquire("taffy-app", profile_key=str(self.a))
+        self.addCleanup(self.clear_redaction)
+
+    def clear_redaction(self):
+        with scoped(self.a): redact.clear_vault_redaction_values()
+        with scoped(self.b): redact.clear_vault_redaction_values()
+
+    def call(self, action, **body):
+        return self.handler({"home": str(self.a), "action": action, **body})
+
+    def choice(self):
+        out = self.call("list")
+        self.assertTrue(out["ok"], out)
+        self.assertNotIn(FAKE, json.dumps(out))
+        return out["items"][0]["id"]
+
+    def test_no_lease_and_an_explicit_agent_lease_refuse_without_opening_browser(self):
+        (self.a / "bot-desktop/lease.json").unlink()
+        with mock.patch.object(owner, "Browser") as browser:
+            self.assertFalse(self.call("list")["ok"])
+            browser.assert_not_called()
+        lease.release(profile_key=str(self.a))
+        with mock.patch.object(owner, "Browser") as browser:
+            self.assertFalse(self.call("list")["ok"])
+            browser.assert_not_called()
+
+    def test_another_human_viewer_cannot_use_the_owner_verb(self):
+        lease.acquire("another-viewer", profile_key=str(self.a))
+        self.assertFalse(self.call("list")["ok"])
+        self.assertEqual(FakeBrowser.writes, 0)
+
+    def test_unknown_profile_refuses(self):
+        out = self.handler({"home": str(self.root / "unknown"), "action": "list"})
+        self.assertFalse(out["ok"])
+        self.assertEqual(FakeBrowser.writes, 0)
+
+    def test_redaction_precedes_write_and_a_later_browser_result_is_redacted(self):
+        from tools.browser_tool import _eval_ok_response
+        out = self.call("fill", choice=self.choice())
+        self.assertTrue(out["ok"], out)
+        self.assertTrue(FakeBrowser.registered_first)
+        self.assertNotIn(FAKE, json.dumps(out))
+        with scoped(self.a):
+            later = _eval_ok_response({"later_field_value": FAKE})
+            self.assertNotIn(FAKE, json.dumps(later))
+            self.assertIn("redacted-vault-secret", json.dumps(later))
+        with scoped(self.b):
+            self.assertEqual(_eval_ok_response(FAKE)["result"], FAKE)
+
+    def test_a_new_control_session_invalidates_an_existing_choice(self):
+        choice = self.choice()
+        lease.release(profile_key=str(self.a))

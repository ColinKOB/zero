+def _streams_chunks(provider: Any) -> bool:
+    """An external-process provider the operator names in HERMES_STREAMING_PROCESS_PROVIDERS
+    (comma-separated) returns chunk iterators for stream=True, so it streams like an HTTP provider.
+    Taffy, Oct 29 2026: the Claude plan plugin streams, and leaving it off held every chat reply
+    until the turn ended."""
+    import os
+
+    names = {n.strip().lower() for n in os.environ.get("HERMES_STREAMING_PROCESS_PROVIDERS", "").split(",")}
+    return str(provider or "").strip().lower() in names - {""}
+

+def test_a_named_external_process_provider_streams(monkeypatch):
+    """HERMES_STREAMING_PROCESS_PROVIDERS opts one external-process provider back into streaming;
+    the rest stay off, and an acp:// endpoint never streams."""
+    from agent.turn_api_call import _should_stream
+    from providers.base import ProviderProfile
+
+    profiles = {n: ProviderProfile(name=n, auth_type="external_process") for n in ("acme-acp", "claude-plan")}
+    monkeypatch.setattr("providers.get_provider_profile", lambda name: profiles.get(name))
+    make = lambda provider, base="process://x": SimpleNamespace(  # noqa: E731
+        provider=provider, base_url=base, _has_stream_consumers=lambda: True)
+
+    monkeypatch.delenv("HERMES_STREAMING_PROCESS_PROVIDERS", raising=False)
+    assert _should_stream(make("claude-plan")) is False
+    monkeypatch.setenv("HERMES_STREAMING_PROCESS_PROVIDERS", " Claude-Plan , other")
+    assert _should_stream(make("claude-plan")) is True
+    assert _should_stream(make("acme-acp")) is False
+    assert _should_stream(make("claude-plan", "acp://x")) is False

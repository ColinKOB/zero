+++ b/tests/agent/test_prune_keeps_request.py
@@ -0,0 +1,54 @@
+"""A mid-turn prune keeps what the current request read (Zero's weekend job, Oct 30 2026), and still clears earlier ones."""
+
+from unittest.mock import patch
+
+from agent.context_compressor import ContextCompressor
+
+
+def _compressor() -> ContextCompressor:
+    with patch("agent.context_compressor.get_model_context_length", return_value=1_000_000):
+        return ContextCompressor(model="m", threshold_percent=0.5, protect_first_n=1, protect_last_n=30,
+                                 proactive_prune_tokens=48000, proactive_prune_min_result_chars=8000,
+                                 proactive_prune_min_reclaim_tokens=4096, quiet_mode=True)
+
+
+def _read(call_id: str, size: int) -> list:
+    return [{"role": "assistant", "content": "", "tool_calls": [
+                {"id": call_id, "type": "function", "function": {"name": "course_status", "arguments": "{}"}}]},
+            {"role": "tool", "tool_call_id": call_id, "content": f"{call_id} " + "x" * size}]
+
+
+def _request(text: str, reads: int, size: int) -> list:
+    out = [{"role": "user", "content": text}]
+    for i in range(reads):
+        out += _read(f"{text[:1]}{i}", size)
+    return out
+
+
+def _kept(messages: list) -> dict:
+    out, _ = _compressor().prune_tool_results_only(messages, current_tokens=120_000)
+    return {m["tool_call_id"]: len(m["content"]) for m in out if m["role"] == "tool"}
+
+
+def test_the_current_request_keeps_its_first_reads_past_the_tail():
+    kept = _kept([{"role": "system", "content": "S"}] + _request("now", 20, 11_000))
+    assert min(kept.values()) > 11_000
+
+
+def test_an_earlier_request_is_still_cleared():
+    kept = _kept([{"role": "system", "content": "S"}] + _request("before", 20, 16_000)
+                 + [{"role": "assistant", "content": "done"}] + _request("now", 20, 1_000))
+    assert kept["b0"] < 1_000
+    assert kept["n0"] > 1_000
+
+
+def test_a_hub_note_continues_the_request():
+    kept = _kept([{"role": "system", "content": "S"}] + _request("now", 20, 8_500)
+                 + [{"role": "assistant", "content": "reply"}, {"role": "user", "content": "[Hub note: Reply check]\nx"}])
+    assert kept["n0"] > 8_500
+
+
+def test_a_request_past_the_keep_size_gives_way_to_the_old_tail():
+    kept = _kept([{"role": "system", "content": "S"}] + _request("now", 40, 16_000))
+    assert kept["n0"] < 16_000
+    assert kept["n39"] > 16_000

 # Hard floor of verbatim recent messages when the budget is exhausted; using the
 # full protect_last_n would recreate the nothing-compactable large-tool-output case.
 _MAX_TAIL_MESSAGE_FLOOR = 8
+# Oct 30 2026: Zero's weekend job read the course page, the course status and the board first, and 18 seconds before its
+# last tool batch this prune cut all three to one line ("[course_status] (16,822 chars result)"). It wrote its plan and
+# its reply without them. The trigger counts the whole request, so 48,000 is passed on the first call, and the prune fires
+# once a turn has more than protect_last_n messages. 39 of 167 tool turns of Oct 25 to 30 lost their own reads this way.
+# A request keeps what it read for itself unless that alone is this large; the 200k compaction still guards the window.
+_CURRENT_REQUEST_KEEP_CHARS = 240_000
+
+
+def _current_request_tail(messages: List[Dict[str, Any]]) -> int:
+    """How many messages the newest request and its work take up, or 0 when they pass the keep size. A hub note, such as
+    the reply check's, continues the request it follows."""
+    for i in range(len(messages) - 1, -1, -1):
+        message = messages[i]
+        if (message.get("role") == "user" and message.get("display_kind") != "steer"
+                and not str(message.get("content") or "").startswith("[Hub note")):
+            kept = sum(len(str(m.get("content") or "")) for m in messages[i:])
+            return len(messages) - i if kept <= _CURRENT_REQUEST_KEEP_CHARS else 0
+    return 0
 

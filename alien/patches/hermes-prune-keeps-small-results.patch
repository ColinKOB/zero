diff --git a/tests/agent/test_prune_keeps_small_results.py b/tests/agent/test_prune_keeps_small_results.py
new file mode 100644
index 00000000..f35b9cb2
--- /dev/null
+++ b/tests/agent/test_prune_keeps_small_results.py
@@ -0,0 +1,53 @@
+"""A compaction prune never leaves a plugin result as only its length (Zero, Nov 1 2026: "354 chars result")."""
+
+from unittest.mock import patch
+
+from agent.context_compressor import ContextCompressor
+
+
+def _compressor() -> ContextCompressor:
+    with patch("agent.context_compressor.get_model_context_length", return_value=100_000):
+        return ContextCompressor(model="m", protect_first_n=1, protect_last_n=2, quiet_mode=True)
+
+
+def _history(tool: str, content: str) -> list:
+    out = [{"role": "system", "content": "S"}, {"role": "user", "content": "check the course"},
+           {"role": "assistant", "content": "", "tool_calls": [
+               {"id": "c1", "type": "function", "function": {"name": tool, "arguments": '{"course": "BNS 101"}'}}]},
+           {"role": "tool", "tool_call_id": "c1", "content": content}]
+    for i in range(10):
+        out += [{"role": "assistant", "content": f"step {i}"}, {"role": "user", "content": f"next {i}"}]
+    return out
+
+
+def _pruned(tool: str, content: str) -> str:
+    c = _compressor()
+    once, _ = c._prune_old_tool_results(_history(tool, content), protect_tail_count=2)
+    twice, _ = c._prune_old_tool_results(once, protect_tail_count=2)
+    assert twice[3]["content"] == once[3]["content"], "a second pass leaves the first stub alone"
+    return once[3]["content"]
+
+
+def test_a_small_plugin_result_stays_whole():
+    content = '{"course": "BNS 101", "status": "graded", "grade": "A-"} ' + "x" * 300
+    assert _pruned("course_status", content) == content
+
+
+def test_a_large_plugin_result_keeps_its_start_and_count():
+    content = '{"course": "BNS 101", "status": "graded", "grade": "A-", "items": "' + "y" * 5000 + '"}'
+    stub = _pruned("course_status", content)
+    assert stub.startswith("[course_status]") and f"({len(content):,} chars result)" in stub
+    assert '"grade": "A-"' in stub
+    assert len(stub) < 500
+
+
+def test_a_tool_with_its_own_summary_keeps_the_upstream_floor():
+    stub = _pruned("terminal", '{"output": "' + "z" * 900 + '", "exit_code": 0}')
+    assert stub.startswith("[terminal]") and len(stub) < 200
+
+
+def test_the_fallback_summary_names_what_a_plugin_result_said():
+    turns = _history("course_status", '{"course": "BNS 101", "status": "graded", "grade": "A-"}')[1:5]
+    summary = _compressor()._build_static_fallback_summary(turns, reason="test")
+    line = next(line for line in summary.splitlines() if "[course_status]" in line)
+    assert '"grade": "A-"' in line

+    async def _handle_session_keepwarm(self, request: "web.Request") -> "web.Response":
+        """POST /api/sessions/{session_id}/keepwarm — refresh an idle chat's prompt cache at read price.
+
+        One model call on a persistence-detached cache-parity fork (the ``/btw`` primitive,
+        ``api_server_keepwarm``): the session's stored system prompt, tools[] and history are replayed
+        byte-identically with a one-line query, so the provider reads the cached prefix and its TTL starts
+        over. Nothing is written to the session. Skipped (200, ``skipped``) while a run holds the session,
+        when it has no stored prompt (the next turn rebuilds it, so there is nothing warm to keep) or no
+        finished reply."""

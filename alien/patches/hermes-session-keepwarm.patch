+        if limited is not None:
+            return limited
+        session_id = request.match_info["session_id"]
+        session, err = await self._get_existing_session_or_404(session_id)
+        if err:
+            return err
+        from gateway.platforms import api_server_keepwarm as _keepwarm
+        db = await self._ensure_session_db_async()
+        tip = (await asyncio.to_thread(db.resolve_resume_session_id, session_id) if db is not None else None) or session_id
+
+        def _skip(reason: str) -> "web.Response":
+            return web.json_response({"object": "hermes.session.keepwarm", "session_id": tip, "skipped": reason})
+
+        if any(getattr(a, "session_id", None) in (session_id, tip) for a in list(self._active_run_agents.values())):

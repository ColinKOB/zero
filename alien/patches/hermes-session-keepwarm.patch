index 0000000..b3eb654
--- /dev/null
+++ b/gateway/platforms/api_server_keepwarm.py
@@ -0,0 +1,56 @@
+"""Keep an idle chat's prompt cache warm at read price (POST /api/sessions/{id}/keepwarm).
+
+A chat's request prefix (tools[], system prompt, history) is cached by the provider for an hour, and every read
+starts that hour again. A person who comes back after the hour pays the whole prefix again as a cache write. The
+hub calls this endpoint about 55 minutes after a chat's last turn: one call on a cache-parity fork (the same
+primitive as ``/btw`` and the background review, agent.background_review.build_cache_parity_fork) replays the
+stored prompt, tools[] and the history byte-identically and adds a one-line query. The provider reads the prefix
+(cache-read price) and writes only the last reply and the query. The fork is persistence-detached: no state.db
+write, no memory provider, no ``pre_llm_call`` hooks, and every tool call is denied at dispatch, so the session,
+its memory and the hub's team notes are exactly as before.
+"""
+
+from typing import Any, Dict, List, Optional
+
+PING = ("[Automatic cache refresh. This is not a message from the person and nothing needs doing. Reply with only "
+        "the word: ok]")
+_DENY = "Cache refresh: tools are off here ({tool_name}). Reply with only the word ok."
+
+
+def trim_snapshot(history: Optional[List[Dict[str, Any]]]) -> List[Dict[str, Any]]:
+    from agent.side_question import trim_snapshot_for_fork
+    return trim_snapshot_for_fork(history)
+
+
+def run_keep_warm(parent: Any, history: Optional[List[Dict[str, Any]]]) -> Dict[str, Any]:
+    """One cache-refresh call for ``parent``'s session. Returns ``{"ok", "usage", "api_calls"}`` or ``{"skipped"}``."""
+    from agent.background_review import _snapshot_review_usage, build_cache_parity_fork
+    from agent.conversation_loop import _restore_or_build_system_prompt
+    from hermes_cli.plugins import clear_thread_tool_whitelist, set_thread_tool_whitelist
+
+    snapshot = trim_snapshot(history)
+    if not snapshot:
+        return {"skipped": "no_finished_reply"}
+    # The prompt and the tools[] pin the next real turn would restore (stored, never rebuilt here: the endpoint
+    # skips a session without a stored prompt).
+    _restore_or_build_system_prompt(parent, None, history)
+    fork, _rt, routed = build_cache_parity_fork(parent, {}, max_iterations=1, write_origin="keep_warm")
+    if routed:
+        fork.close()
+        return {"skipped": "routed"}
+    try:
+        set_thread_tool_whitelist(set(), deny_msg_fmt=_DENY)
+        result = fork.run_conversation(user_message=PING, conversation_history=snapshot)
+        usage = _snapshot_review_usage(fork)
+    finally:
+        clear_thread_tool_whitelist()
+        for step in (fork.shutdown_memory_provider, fork.close):
+            try:
+                step()
+            except Exception:
+                pass
+    result = result if isinstance(result, dict) else {}
+    out = {"ok": not result.get("error"), "usage": usage, "api_calls": result.get("api_calls")}
+    if result.get("error"):
+        out["error"] = str(result["error"])[:300]
+    return out

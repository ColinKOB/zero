diff --git a/agent/text_token_scale.py b/agent/text_token_scale.py
new file mode 100644
index 0000000..716b8a3
--- /dev/null
+++ b/agent/text_token_scale.py
@@ -0,0 +1,155 @@
+"""Real tokens per estimated text token, learned per model from the provider's own usage (Zero, Oct 28 2026).
+
+Every rough estimate counts text at ``CHARS_PER_TOKEN`` (4) bytes a token, which fits the GPT tokenizers it was
+calibrated on. Claude Opus 5.5 spends a token on about 2.8 characters of the same text, so Hermes counted Zero's
+real 149,745-token request as 101,341: 13.1k real for a system prompt it counted as 9.7k, 60k for 122 tool schemas it
+counted as 39.8k, and 76k for history it counted as 51.8k. The usage anchor kept the compaction trigger honest, but
+every figure without an anchor (the compactor's tail and reclaim budgets, the request after a compaction, gateway
+hygiene) was about a third too small, so a compaction planned to leave room left much less of it.
+
+The provider prices each request exactly, so the ratio is observable: on a turn's first response, real prompt
+tokens over the unscaled estimate of the request just sent. It is learned per ``model@host``, kept in
+``<home>/cache/text_token_scales.json`` so a new session starts calibrated, and bound per turn through a ContextVar
+(as ``agent.image_token_cost`` binds the image price) so the trigger, the anchored delta, the compactor's budget walk
+and gateway hygiene all count in the same, real units.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+from contextvars import ContextVar
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_TEXT_TOKEN_SCALE = 1.0
+# A ratio outside this band is a broken reading (a truncated usage block, a request the estimate never saw), not
+# a tokenizer.
+_MIN_PLAUSIBLE, _MAX_PLAUSIBLE = 0.5, 3.0
+# Tiny requests are mostly fixed wrapper text the estimate cannot see; they would teach a ratio that is too high.
+_MIN_CALIBRATION_TOKENS = 2_000
+_EMA_ALPHA = 0.3
+
+_scale_var: ContextVar[Optional[float]] = ContextVar("hermes_text_token_scale", default=None)
+_LEARNED: Dict[str, float] = {}
+_LOADED = False
+_LEARNED_BY_HOME: Dict[str, Dict[str, float]] = {}
+
+
+def _cache_path():
+    from agent.model_metadata import _cache_file
+
+    return _cache_file("text_token_scales.json")
+
+
+def _key(model: Any, base_url: Any) -> str:
+    from utils import base_url_hostname
+
+    return f"{model or ''}@{base_url_hostname(base_url or '') or ''}"
+
+
+def _read_cache() -> Dict[str, float]:
+    from agent.model_metadata import _load_json_dict
+
+    return {k: float(v) for k, v in _load_json_dict(_cache_path()).items()
+            if isinstance(v, (int, float)) and not isinstance(v, bool) and _MIN_PLAUSIBLE <= v <= _MAX_PLAUSIBLE}
+
+
+def _table() -> Dict[str, float]:
+    """The active profile's learned table, loaded lazily from its own cache file (a multiplexed gateway serves
+    several homes, as in ``agent.image_token_cost``)."""
+    global _LOADED
+    from hermes_constants import get_hermes_home_override, hermes_home_key
+
+    if get_hermes_home_override() is None:
+        if not _LOADED:
+            _LOADED = True
+            _LEARNED.update(_read_cache())
+        return _LEARNED
+    home_key = hermes_home_key()
+    table = _LEARNED_BY_HOME.get(home_key)
+    if table is None:
+        table = _LEARNED_BY_HOME[home_key] = _read_cache()
+    return table
+
+
+def learned_text_token_scale(model: Any, base_url: Any) -> float:
+    """Learned scale for ``model@host``, else 1.0 (the plain estimate)."""
+    return _table().get(_key(model, base_url), DEFAULT_TEXT_TOKEN_SCALE)
+
+
+def current_text_token_scale() -> float:
+    bound = _scale_var.get()
+    return bound if bound is not None else DEFAULT_TEXT_TOKEN_SCALE
+
+
+def scale_tokens(tokens: int) -> int:
+    """``tokens`` of rough text estimate in the bound model's real tokens."""
+    scale = current_text_token_scale()
+    return tokens if scale == 1.0 else int(tokens * scale + 0.5)
+
+
+@contextlib.contextmanager
+def text_scale_context(scale: Optional[float]):
+    token = _scale_var.set(scale)
+    try:
+        yield
+    finally:
+        _scale_var.reset(token)
+
+
+def bind_text_token_scale(agent: Any) -> None:
+    """Bind the agent's learned scale to the current context for the rest of the turn."""
+    _scale_var.set(learned_text_token_scale(getattr(agent, "model", None), getattr(agent, "base_url", None)))
+
+
+def calibrate_from_usage(agent: Any, messages: List[Dict[str, Any]], prompt_tokens: Any) -> Optional[float]:
+    """Learn the scale from the response that just priced ``messages`` with the agent's system prompt and tools.
+
+    Call it for a turn's first response only: later ones also carry that turn's own replayed thinking, which no
+    estimate sees. A request with images teaches nothing (their price is learned separately). The next turn's
+    binding picks the new value up. Returns the new learned scale, or None; never raises."""
+    try:
+        return _calibrate(agent, messages, prompt_tokens)
+    except Exception:
+        logger.debug("text token scale calibration failed", exc_info=True)
+        return None
+
+
+def _calibrate(agent: Any, messages: List[Dict[str, Any]], prompt_tokens: Any) -> Optional[float]:
+    from agent.image_token_cost import count_images
+    from agent.model_metadata import estimate_request_tokens_rough
+
+    system, tools = getattr(agent, "_cached_system_prompt", None) or "", getattr(agent, "tools", None) or None
+    model, base_url = getattr(agent, "model", None), getattr(agent, "base_url", None)
+    try:
+        real = int(prompt_tokens or 0)
+    except (TypeError, ValueError):
+        return None
+    if (real <= 0 or not isinstance(messages, list) or not messages or not isinstance(system, str)
+            or not isinstance(tools, (list, type(None))) or not isinstance(model, str) or not model
+            or not isinstance(base_url, (str, type(None))) or count_images(messages)):
+        return None
+    with text_scale_context(DEFAULT_TEXT_TOKEN_SCALE):
+        rough = estimate_request_tokens_rough(messages, system_prompt=system, tools=tools)
+    if rough < _MIN_CALIBRATION_TOKENS:
+        return None
+    observed = real / rough
+    if not _MIN_PLAUSIBLE <= observed <= _MAX_PLAUSIBLE:
+        return None
+    key = _key(model, base_url)
+    table = _table()
+    prior = table.get(key)
+    learned = round(observed if prior is None else prior + _EMA_ALPHA * (observed - prior), 4)
+    table[key] = learned
+    try:
+        from utils import atomic_json_write
+
+        atomic_json_write(_cache_path(), dict(table), indent=0, separators=(",", ":"))
+    except Exception:
+        logger.debug("text token scale persist failed", exc_info=True)
+    if prior is None or abs(learned - prior) >= 0.02:
+        logger.info("Text token scale calibrated from provider usage: %s real for %s estimated (learned %.3f for %s)",
+                    f"{real:,}", f"{rough:,}", learned, key)
+    return learned

diff --git a/tests/agent/test_text_token_scale.py b/tests/agent/test_text_token_scale.py
new file mode 100644
index 0000000..c2b2ca1
--- /dev/null
+++ b/tests/agent/test_text_token_scale.py
@@ -0,0 +1,123 @@
+"""Real tokens per estimated token, learned from provider usage (agent/text_token_scale.py, Zero, Oct 28 2026).
+
+Zero's chat on Oct 28 sent a request Claude Opus 5.5 priced at 149,745 tokens (10:47 a.m. request dump, sent again at
+11:42). Hermes estimated the same request at 101,341: system prompt 9,734 (real 13.1k), 122 tool schemas 39,801 (real
+about 60k), history 51,806 (real about 76k). Every part was short by the same factor because the estimate counts 4
+characters a token and this tokenizer spends one on about 2.8.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent import text_token_scale as tts
+from agent.context_compressor import _estimate_msg_budget_tokens
+from agent.model_metadata import estimate_messages_tokens_rough, estimate_request_tokens_rough
+
+REAL_PROMPT_TOKENS = 149_745
+OPUS = SimpleNamespace(model="opus", base_url="process://claude-subscription-directsdk-experimental")
+
+
+def _isolate(monkeypatch, tmp_path):
+    monkeypatch.setattr(tts, "_LEARNED", {})
+    monkeypatch.setattr(tts, "_LOADED", True)
+    monkeypatch.setattr(tts, "_LEARNED_BY_HOME", {})
+    monkeypatch.setattr(tts, "_cache_path", lambda: tmp_path / "text_token_scales.json")
+
+
+def _zero_request():
+    """A request with the estimated sizes of Zero's real one: 9,734 system, 39,801 tools, about 51.8k history."""
+    system = "s" * (9_734 * 4)
+    tools = [{"type": "function", "function": {"name": "t", "description": "d" * (39_801 * 4 - 3), "parameters": {}}}]
+    messages = [{"role": "user", "content": "summary " * 14_000},
+                {"role": "assistant", "content": "reply " * 4_000},
+                {"role": "user", "content": "turn " * 14_000}]
+    return system, tools, messages
+
+
+def _agent(system, tools, **extra):
+    return SimpleNamespace(**vars(OPUS), _cached_system_prompt=system, tools=tools, **extra)
+
+
+def test_zeros_real_request_is_counted_in_real_tokens_after_one_reading(monkeypatch, tmp_path):
+    _isolate(monkeypatch, tmp_path)
+    system, tools, messages = _zero_request()
+    with tts.text_scale_context(None):
+        rough = estimate_request_tokens_rough(messages, system_prompt=system, tools=tools)
+        assert rough == pytest.approx(101_341, rel=0.01)
+        learned = tts.calibrate_from_usage(_agent(system, tools), messages, REAL_PROMPT_TOKENS)
+        assert learned == pytest.approx(1.478, abs=0.01)
+        tts.bind_text_token_scale(OPUS)   # the next turn's binding
+        counted = estimate_request_tokens_rough(messages, system_prompt=system, tools=tools)
+    assert counted == pytest.approx(REAL_PROMPT_TOKENS, rel=0.005)
+
+
+def test_the_compactor_walk_counts_in_the_same_units_as_the_trigger(monkeypatch, tmp_path):
+    """A trigger in real tokens over a tail walk in rough ones would never see a compaction get under it."""
+    _isolate(monkeypatch, tmp_path)
+    row = {"role": "user", "content": "kept turn " * 2_000}
+    with tts.text_scale_context(None):
+        plain_walk, plain_estimate = _estimate_msg_budget_tokens(row), estimate_messages_tokens_rough([row])
+    with tts.text_scale_context(1.5):
+        assert _estimate_msg_budget_tokens(row) == pytest.approx(plain_walk * 1.5, abs=1)
+        assert estimate_messages_tokens_rough([row]) == pytest.approx(plain_estimate * 1.5, abs=1)
+
+
+def test_a_fresh_process_starts_calibrated_for_that_model_only(monkeypatch, tmp_path):
+    _isolate(monkeypatch, tmp_path)
+    system, tools, messages = _zero_request()
+    with tts.text_scale_context(None):
+        tts.calibrate_from_usage(_agent(system, tools), messages, REAL_PROMPT_TOKENS)
+    monkeypatch.setattr(tts, "_LEARNED", {})
+    monkeypatch.setattr(tts, "_LEARNED_BY_HOME", {})
+    monkeypatch.setattr(tts, "_LOADED", False)
+    assert tts.learned_text_token_scale(OPUS.model, OPUS.base_url) == pytest.approx(1.478, abs=0.01)
+    assert tts.learned_text_token_scale("gpt-6.1-sol", "https://chatgpt.com/backend-api/codex") == 1.0
+
+

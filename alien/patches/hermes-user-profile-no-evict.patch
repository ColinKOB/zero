@@ -0,0 +1,114 @@
+"""A full user profile never makes room by removing or shortening other entries (Zero, Oct 29 2026).
+
+Zero's USER.md held 16 entries in 4,927 of its 5,000 characters, eleven of them Colin's rules for how to work. When a
+new rule did not fit, the tool told the model to remove or shorten "stale" entries in the same batch, so the model
+chose which of his rules to drop. These tests use that shape: a store a few dozen characters under its cap and a new
+rule of about 200 characters.
+"""
+
+import pytest
+
+from tools.memory_tool import MemoryStore, memory_tool
+from tools.memory_tool_store import ENTRY_DELIMITER
+
+LIMIT = 5000
+RULE = ("Brain dumps: when Colin says he is brain dumping, reply only 'Got it. What else?' after each item "
+        "until he says done, then give the whole list back in order.")
+
+
+def _entries():
+    """Sixteen entries filling 4,927 characters, like Zero's live USER.md on Oct 28."""
+    entries = [f"Entry {i}: " + " ".join(["rule text"] * 29) for i in range(16)]
+    pad = 4927 - len(ENTRY_DELIMITER.join(entries))
+    entries[0] += "x" * pad
+    assert len(ENTRY_DELIMITER.join(entries)) == 4927
+    return entries
+
+
+@pytest.fixture()
+def store(tmp_path, monkeypatch):
+    monkeypatch.setattr("tools.memory_tool.get_memory_dir", lambda: tmp_path)
+    (tmp_path / "USER.md").write_text(ENTRY_DELIMITER.join(_entries()), encoding="utf-8")
+    s = MemoryStore(memory_char_limit=LIMIT, user_char_limit=LIMIT)
+    s.load_from_disk()
+    return s
+
+
+def _on_disk(tmp_path):
+    return MemoryStore._read_file(tmp_path / "USER.md")
+
+
+def test_full_user_add_points_to_save_fact_and_changes_nothing(store, tmp_path):
+    result = store.add("user", RULE)
+    assert result["success"] is False and result["done"] is True
+    assert "save_fact" in result["error"] and "preference" in result["error"]
+    assert "Do not remove or shorten" in result["error"]
+    assert "current_entries" not in result
+    assert _on_disk(tmp_path) == _entries()
+
+
+def test_batch_that_removes_to_make_room_is_refused(store, tmp_path):
+    entries = _entries()
+    result = store.apply_batch("user", [
+        {"action": "remove", "old_text": entries[7]},
+        {"action": "add", "content": RULE},
+    ])
+    assert result["success"] is False and "save_fact" in result["error"]
+    assert _on_disk(tmp_path) == entries
+
+
+def test_batch_that_shortens_to_make_room_is_refused(store, tmp_path):
+    entries = _entries()
+    result = store.apply_batch("user", [
+        {"action": "replace", "old_text": entries[12], "content": "Entry 12: short."},
+        {"action": "add", "content": RULE},
+    ])
+    assert result["success"] is False and "save_fact" in result["error"]
+    assert _on_disk(tmp_path) == entries
+
+
+def test_remove_after_a_refused_add_waits_for_the_next_turn(store, tmp_path):
+    entries = _entries()
+    store.add("user", RULE)
+    result = store.remove("user", entries[5])
+    assert result["success"] is False and "save_fact" in result["error"]
+    replaced = store.replace("user", entries[6], "Entry 6: shorter.")
+    assert replaced["success"] is False
+    assert _on_disk(tmp_path) == entries
+
+    store.reset_consolidation_failures()
+    assert store.remove("user", entries[5])["success"] is True
+    assert entries[5] not in _on_disk(tmp_path)
+
+
+def test_replace_that_grows_past_the_cap_is_refused(store, tmp_path):
+    entries = _entries()
+    result = store.replace("user", entries[3], entries[3] + " and more" * 20)
+    assert result["success"] is False and "save_fact" in result["error"]
+    assert _on_disk(tmp_path) == entries
+
+
+def test_corrections_that_fit_still_work(store, tmp_path):
+    entries = _entries()
+    assert store.replace("user", entries[2], "Entry 2: lives in Boston now.")["success"] is True
+    assert store.apply_batch("user", [
+        {"action": "remove", "old_text": entries[4]},
+        {"action": "add", "content": "Entry 16: short new fact."},
+    ])["success"] is True
+    on_disk = _on_disk(tmp_path)
+    assert "Entry 2: lives in Boston now." in on_disk and entries[4] not in on_disk
+
+
+def test_memory_target_keeps_the_consolidation_path(tmp_path, monkeypatch):
+    monkeypatch.setattr("tools.memory_tool.get_memory_dir", lambda: tmp_path)
+    s = MemoryStore(memory_char_limit=500, user_char_limit=500)
+    s.load_from_disk()
+    s.add("memory", "x" * 490)
+    result = s.add("memory", "this will exceed the limit")
+    assert result["success"] is False and "current_entries" in result and "save_fact" not in result["error"]
+
+
+def test_tool_entry_point_returns_the_refusal(store):
+    import json
+    result = json.loads(memory_tool(action="add", target="user", content=RULE, store=store))
+    assert result["success"] is False and "save_fact" in result["error"]

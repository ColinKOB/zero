+    def child_frames(self, top_origin: str, origins: Tuple[str, ...], *, timeout: float = 10.0) -> Dict[str, Any]:
+        """Cross-origin iframes (OOPIF targets) inside the attached page whose address is on one of ``origins``,
+        at any depth: ``{"ok": True, "frames": [{"target_id", "origin"}]}``. Every frame from the iframe up to the
+        page's main frame must be on ``top_origin`` or one of ``origins``, and the main frame on ``top_origin``. So
+        another tab on the same site never lends its iframes, and a third party's frame on the page can't host a
+        processor iframe of its own that gets the card (Codex review of zero-private #128)."""
+        loop = self._loop
+        if loop is None or not loop.is_running():
+            return _fail("supervisor loop is not running")
+        with self._state_lock:
+            session_id = self._page_session_id
+        if not session_id:
+            return _fail("supervisor has no attached page session")
+
+        async def _list() -> Dict[str, Any]:
+            from agent.vault_store import normalize_origin
+
+            def _origin(url: Any) -> str:
+                try:
+                    return normalize_origin(str(url or ""))
+                except Exception:
+                    return ""
+
+            tree = (await self._cdp("Page.getFrameTree", session_id=session_id, timeout=timeout))["result"]["frameTree"]
+            root = tree["frame"]["id"]
+            # frame id -> (parent frame id, origin), for the page's own frames and then every iframe target.
+            frames_by_id, stack = {}, [tree]
+            while stack:
+                node = stack.pop()
+                frame = node["frame"]
+                frames_by_id[frame["id"]] = (frame.get("parentId"), _origin(frame.get("securityOrigin") or frame.get("url")))
+                stack.extend(node.get("childFrames") or [])
+            infos = (await self._cdp("Target.getTargets", timeout=timeout)).get("result", {}).get("targetInfos", [])
+            iframes = [t for t in infos if t.get("type") == "iframe"]
+            for t in iframes:
+                frames_by_id[t["targetId"]] = (t.get("parentFrameId") or t.get("parentId"), _origin(t.get("url")))
+            trusted = {top_origin, *origins}
+
+            def _chain_ok(frame_id: Any) -> bool:
+                seen = set()
+                while frame_id in frames_by_id and frame_id not in seen:
+                    seen.add(frame_id)
+                    parent, origin = frames_by_id[frame_id]
+                    if origin not in trusted:
+                        return False
+                    if frame_id == root:
+                        return origin == top_origin
+                    frame_id = parent
+                return False
+
+            return {"ok": True, "frames": [{"target_id": t["targetId"], "origin": frames_by_id[t["targetId"]][1]}
+                                           for t in iframes
+                                           if frames_by_id[t["targetId"]][1] in origins and _chain_ok(t["targetId"])]}
+
+        try:
+            return _schedule(_list(), loop, timeout=timeout + 1)
+        except Exception as exc:
+            return _err(exc)
+
+    def evaluate_in_frame(self, target_id: str, expression: str, *, timeout: float = 10.0) -> Dict[str, Any]:
+        """``evaluate_runtime`` inside one iframe target (see ``child_frames``), on a session of its own that is
+        detached afterwards."""
+        loop = self._loop
+        if loop is None or not loop.is_running():
+            return _fail("supervisor loop is not running")
+
+        async def _run() -> Dict[str, Any]:
+            attach = await self._cdp("Target.attachToTarget", {"targetId": target_id, "flatten": True}, timeout=timeout)
+            sid = attach["result"]["sessionId"]
+            try:
+                return await self._cdp("Runtime.evaluate", {"expression": expression, "returnByValue": True,
+                                                            "awaitPromise": True, "userGesture": True},
+                                       session_id=sid, timeout=timeout)
+            finally:
+                with contextlib.suppress(Exception):
+                    await self._cdp("Target.detachFromTarget", {"sessionId": sid}, timeout=timeout)
+
+        try:
+            return _runtime_value(_schedule(_run(), loop, timeout=timeout * 3 + 1))
+        except Exception as exc:
+            return _err(exc)
 

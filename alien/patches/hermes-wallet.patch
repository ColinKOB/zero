+_TOTAL_LABEL = re.compile(r"\b(order\s*total|grand\s*total|total\s*(?:due|to\s*pay|charged)|amount\s*due|"
+                          r"estimated\s*total|total)\b", re.I)
+_NOT_TOTAL = re.compile(r"sub\s*-?\s*total|before\s*tax|savings|you\s*save|items?\s*\(|per\s*month", re.I)
+_AMOUNT = re.compile(r"(?:\$|\bUSD)\s?(\d[\d.,]*)|(\d[\d.,]*)\s?USD\b")
+_US_FORMAT = re.compile(r"(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d{2}))?")
+_FOREIGN = re.compile(r"[\u20ac\u00a3\u00a5\u20b9\u20a9\u20bd]|\b(?!US\$)[A-Z]{1,2}\$|\b(?!USD)[A-Z]{3}\s?\d|\d\s?(?!USD)[A-Z]{3}\b")
+
+
+def parse_order_total(text: str) -> Optional[int]:
+    """The order total a checkout page shows, in cents, or None when no line reads as one. "Order total",
+    "Grand total" and "Amount due" win over a bare "Total"; subtotals and savings are skipped; the last match
+    of the strongest label counts (summaries end with the total). A label whose amount sits on the next line
+    (how innerText lays out most summaries) is read with that line. Only a dollar amount counts; a total in
+    another currency or written another way ("1.234,50 \u20ac") makes the whole page None, since misreading it
+    could pass a total the approval doesn't cover."""
+    lines = [ln.strip() for ln in str(text or "").splitlines() if ln.strip()]
+    best: Optional[int] = None
+    best_rank = 0
+    for i, line in enumerate(lines):
+        label = _TOTAL_LABEL.search(line)
+        if not label or _NOT_TOTAL.search(line):
+            continue
+        rest = line[label.end():]
+        if not _AMOUNT.search(rest) and not _FOREIGN.search(rest) and i + 1 < len(lines):
+            rest = lines[i + 1]
+        if _FOREIGN.search(rest):
+            return None
+        money = _AMOUNT.search(rest)
+        if not money:
+            continue
+        us = _US_FORMAT.fullmatch((money.group(1) or money.group(2)).rstrip(".,"))
+        if not us:
+            return None
+        rank = 1 if label.group(1).lower().replace(" ", "") == "total" else 2
+        cents = int(us.group(1).replace(",", "")) * 100 + int(us.group(2) or 0)
+        if rank >= best_rank:
+            best, best_rank = cents, rank
+    return best
+

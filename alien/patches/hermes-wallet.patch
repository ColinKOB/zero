+def _read_order_total(task_id: str) -> Optional[int]:
+    """The visible order total of the current page (non-secret read), or None."""
+    res = _eval_js(task_id, "(document.body && document.body.innerText || '').slice(0, 60000)")
+    if not res.get("success"):
+        return None
+    raw = res.get("result")
+    return parse_order_total(raw if isinstance(raw, str) else str(raw or ""))
+

+@pytest.fixture
+def two_origin_checkout(tmp_path):
+    """A checkout page on 127.0.0.1 whose card fields are in an iframe served from localhost: two sites, so the
+    iframe is an OOPIF, the way Stripe Elements serve js.stripe.com on a merchant's page. The page also embeds a
+    third party's widget from widget.localhost (a third site) that holds a card iframe of its own. Yields (top, card
+    frame, third party)."""
+    import functools
+    import http.server
+    import threading
+
+    (tmp_path / "card.html").write_text('<input name="cardnumber" autocomplete="cc-number">')
+    servers = []
+    for _ in range(3):
+        handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(tmp_path))
+        server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        servers.append(server)
+    top = f"http://127.0.0.1:{servers[0].server_address[1]}"
+    frame = f"http://localhost:{servers[1].server_address[1]}"
+    third = f"http://widget.localhost:{servers[2].server_address[1]}"
+    (tmp_path / "widget.html").write_text(f'<iframe src="{frame}/card.html"></iframe>')
+    (tmp_path / "checkout.html").write_text(f'<h1>Order total $20.00</h1><iframe src="{frame}/card.html"></iframe>'
+                                            f'<iframe src="{third}/widget.html"></iframe>')
+    yield top, frame, third
+    for server in servers:
+        server.shutdown()
+
+
+def _open_tab(port: int, url: str) -> None:
+    import urllib.request
+    urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{port}/json/new?{url}", method="PUT"), timeout=5)
+
+
+def test_child_frames_and_evaluate_in_frame_reach_a_cross_origin_card_iframe(chrome_cdp, supervisor_registry,
+                                                                            two_origin_checkout):
+    from agent.vault_login_classifier import build_fill_js
+
+    cdp_url, port = chrome_cdp
+    top, frame_origin, third_party = two_origin_checkout
+    _open_tab(port, f"{top}/checkout.html")
+    _open_tab(port, f"{top}/checkout.html")   # a second tab on the same site must not lend its iframe
+    time.sleep(2.0)
+    supervisor = supervisor_registry.get_or_start(task_id="pytest-frames", cdp_url=cdp_url)
+    assert supervisor.focus_page(top)["ok"]
+
+    listed = supervisor.child_frames(top, (frame_origin,))
+    assert listed["ok"] is True and len(listed["frames"]) == 1   # the card frame inside the third party's is left out
+    assert listed["frames"][0]["origin"] == frame_origin
+    assert supervisor.child_frames(top, ("https://js.stripe.com",))["frames"] == []
+    assert supervisor.child_frames("https://evil.test", (frame_origin,))["frames"] == []
+    target = listed["frames"][0]["target_id"]
+    assert supervisor.evaluate_in_frame(target, "location.origin")["result"] == frame_origin
+
+    supervisor.evaluate_in_frame(target, "document.querySelector('input').setAttribute('data-hermes-vault-slot', 'n:0')")
+    fill = [{"index": 0, "token": "cc-number", "value": "4242424242424242"}]
+    refused = supervisor.evaluate_in_frame(target, build_fill_js(fill, frame_origin, "n", top_origin="https://evil.test"))
+    assert json.loads(refused["result"]) == {"refused": "origin_changed", "found": top}
+
+    # The card frame inside the third party's widget: listed only when the third party is trusted too, and even then
+    # a fill that trusts only the processor refuses it.
+    everything = supervisor.child_frames(top, (frame_origin, third_party))["frames"]
+    nested = [f["target_id"] for f in everything if f["origin"] == frame_origin and f["target_id"] != target]
+    assert len(everything) == 3 and len(nested) == 1
+    supervisor.evaluate_in_frame(nested[0], "document.querySelector('input').setAttribute('data-hermes-vault-slot', 'n:0')")
+    refused = supervisor.evaluate_in_frame(nested[0], build_fill_js(fill, frame_origin, "n", top_origin=top,
+                                                                    frame_origins=(frame_origin,)))
+    assert json.loads(refused["result"]) == {"refused": "origin_changed", "found": third_party}
+    assert supervisor.evaluate_in_frame(nested[0], "document.querySelector('input').value")["result"] == ""
+    assert supervisor.evaluate_in_frame(target, "document.querySelector('input').value")["result"] == ""
+    done = supervisor.evaluate_in_frame(target, build_fill_js(fill, frame_origin, "n", top_origin=top,
+                                                              frame_origins=(frame_origin,)))
+    assert json.loads(done["result"]) == {"filled": 1}
+    assert supervisor.evaluate_in_frame(target, "document.querySelector('input').value")["result"] == "4242424242424242"

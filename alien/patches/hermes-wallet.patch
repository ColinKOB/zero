+def _focus_own_tab(task_id: str, kind: str) -> Optional[str]:
+    """Point the supervisor's page session at the tab the agent's snapshots and clicks use, when that tab holds a
+    ``kind`` form, and return its origin. Else None, with the page session left where it was. focus_page alone takes
+    the first matching tab, so with two tabs on one login page the password could land in the other one: the fill said
+    success and the agent's box stayed empty (Oct 30, Bloomerang). agent-browser's eval runs in the agent's tab, so it
+    sets a random mark there that only that tab answers to. The mark is not secret, and a page that copies it to
+    another tab stays on its own origin, which the fill script checks anyway. browser_exec sessions have no such tab."""
+    from agent.vault_store import normalize_origin
+    from tools.browser_tool import _active_sessions, _last_session_key
+    from tools.browser_tool_session import _run_browser_command
+
+    session_key = _last_session_key(task_id)
+    if session_key not in _active_sessions:
+        return None
+    try:
+        supervisor = _ensure_supervisor(task_id)
+    except Exception:
+        supervisor = None
+    if supervisor is None:
+        return None
+    mark = json.dumps(secrets.token_hex(8))
+    marked = _run_browser_command(session_key, "eval", [f"window.__hermesOwnTab={mark};location.origin"])
+    try:
+        origin = normalize_origin(str((marked.get("data") or {}).get("result") or ""))
+    except Exception:  # about:blank and other pages with no origin
+        return None
+    if not marked.get("success") or not origin:
+        return None
+    probe = _TAB_PROBES.get(kind)
+    accept = f"window.__hermesOwnTab==={mark}" + (f" && ({probe})" if probe else "")
+    return origin if supervisor.focus_page(origin, accept=accept).get("ok") else None

+# ---------------------------------------------------------------------------
+# One-time approvals for card and ID fills
+# ---------------------------------------------------------------------------
+# A payment or identity item fills only with an approval issued for that one use. The embedding app
+# registers the function that redeems it (Zero's taffy-tools plugin asks its hub, which checks the
+# approval, the profile, the item, the exact page origin, the expiry and the order total, and says yes
+# once). The fill then targets the origin the approval was redeemed for, whatever origin the item was
+# saved with. With no redeemer registered, every payment and identity fill is refused.
+_NEEDS_APPROVAL = ("payment", "identity")
+_APPROVAL_REDEEMER = None
+
+
+def register_approval_redeemer(fn) -> None:
+    """``fn(approval=, handle=, origin=, total_cents=) -> {"ok": bool, "error": str}``."""
+    global _APPROVAL_REDEEMER
+    _APPROVAL_REDEEMER = fn
+
+
+def _redeem_approval(approval: str, handle: str, origin: str, total_cents: Optional[int]) -> Dict[str, Any]:
+    if _APPROVAL_REDEEMER is None:
+        return {"ok": False, "error": "Card and ID fills are not set up on this computer."}
+    try:
+        verdict = _APPROVAL_REDEEMER(approval=approval, handle=handle, origin=origin, total_cents=total_cents)
+    except Exception as exc:
+        logger.warning("vault fill: approval check failed (%s)", type(exc).__name__)
+        return {"ok": False, "error": "The approval could not be checked. Nothing was filled."}
+    return verdict if isinstance(verdict, dict) else {"ok": False, "error": "The approval was not accepted."}
+
+
+# ---------------------------------------------------------------------------
+# Logins on another page of the same site
+# ---------------------------------------------------------------------------
+# A site often asks for the password on a sibling host: OpenAI's login is saved for platform.openai.com and its
+# password form is on auth.openai.com (Zero, Oct 20 2026). The embedding app registers how to name a host's site
+# (Zero's taffy-tools plugin uses the Public Suffix List, so a.sharepoint.com and b.sharepoint.com stay apart);
+# with none registered, logins fill only on their exact origins. Cards, IDs and addresses never widen.
+_LOGIN_SITE = None
+
+
+def register_login_site(fn) -> None:
+    """``fn(host) -> str``: the registrable domain of ``host`` (auth.openai.com is openai.com), or "" when it
+    can't be told safely (an IP address, a public suffix)."""
+    global _LOGIN_SITE
+    _LOGIN_SITE = fn
+
+
+def _same_login_site(page_origin: str, allowed: list) -> bool:
+    if _LOGIN_SITE is None or not page_origin.startswith("https://"):
+        return False
+    try:
+        site = _LOGIN_SITE(urlsplit(page_origin).hostname or "")
+        return bool(site) and any(_LOGIN_SITE(urlsplit(o).hostname or "") == site for o in allowed)
+    except Exception as exc:
+        logger.warning("vault fill: login site check failed (%s)", type(exc).__name__)
+        return False
+

+# expiry and CVC in js.stripe.com frames on the merchant's page (OpenAI's billing is one, Oct 20 2026). A card fills
+# into a frame only on these origins, and only inside the page the approval was redeemed for.
+_CARD_FRAME_ORIGINS = ("https://js.stripe.com",)

+def _card_frame_fills(task_id: str, page_origin: str, secret: Dict[str, Any]) -> list:
+    """``[(frame target, frame origin, inspection nonce, fills)]`` for the card fields in the current page's payment
+    processor iframes (non-secret inspection; the values ride only in the fills)."""
+    from agent.vault_login_classifier import (LoginControl, build_inspection_js, classify_checkout_control,
+                                              select_checkout_fills)
+    from agent.vault_store import PAYMENT_FIELDS
+
+    try:
+        supervisor = _ensure_supervisor(task_id)
+    except Exception:
+        supervisor = None
+    listed = supervisor.child_frames(page_origin, _CARD_FRAME_ORIGINS) if supervisor is not None else {}
+    out = []
+    for frame in listed.get("frames") or []:
+        nonce = secrets.token_hex(8)
+        inspect = supervisor.evaluate_in_frame(frame["target_id"], build_inspection_js(nonce))
+        raw = _parse_json_result(inspect.get("result")) if inspect.get("ok") else None
+        controls = [c for c in (classify_checkout_control(LoginControl.from_dict(r))
+                                for r in (raw if isinstance(raw, list) else []) if isinstance(r, dict)) if c]
+        fills = select_checkout_fills(controls, secret, PAYMENT_FIELDS) if controls else []
+        if fills:
+            out.append((frame["target_id"], frame["origin"], nonce, fills))
+    return out

+def _digit_groupings(digits: str) -> List[str]:
+    """The ways a page or a person writes a number: as typed, in groups of four (cards), 3-2-4 (US Social
+    Security) and 4-6-5 (American Express), each with spaces or dashes."""
+    groups = [[4] * (len(digits) // 4) + ([len(digits) % 4] if len(digits) % 4 else [])]
+    if len(digits) == 9:
+        groups.append([3, 2, 4])
+    if len(digits) == 15:
+        groups.append([4, 6, 5])
+    out = [digits]
+    for sizes in groups:
+        parts, i = [], 0
+        for n in sizes:
+            parts.append(digits[i:i + n])
+            i += n
+        for sep in (" ", "-"):
+            out.append(sep.join(parts))
+    return out
+
+
+def _phone_formats(value: str) -> List[str]:
+    """The ways a checkout reformats a US phone number it was given: 5035550100 may come back as (503) 555-0100,
+    503-555-0100, 503.555.0100 or +1 503-555-0100."""
+    digits = re.sub(r"\D", "", value)
+    if len(digits) == 11 and digits.startswith("1"):
+        digits = digits[1:]
+    if len(digits) != 10:
+        return [digits] if len(digits) >= 7 else []
+    a, b, c = digits[:3], digits[3:6], digits[6:]
+    local = [f"{a}{b}{c}", f"{a}-{b}-{c}", f"{a} {b} {c}", f"{a}.{b}.{c}", f"({a}) {b}-{c}", f"({a}){b}-{c}",
+             f"({a}) {b} {c}"]
+    return local + [f"1{local[0]}", f"+1{local[0]}", f"1-{local[1]}"] + [f"+1 {n}" for n in local[1:]]
+
+
+_DATE_INPUTS = ("%Y-%m-%d", "%m/%d/%Y", "%m-%d-%Y", "%m.%d.%Y", "%Y/%m/%d", "%m%d%Y", "%Y%m%d")
+
+
+def _date_formats(value: str) -> List[str]:
+    """The ways a form reformats a date of birth it was given: 01/02/1990 may come back as 1990-01-02, 1/2/1990,
+    Jan 2, 1990 or 2 January 1990 (Codex review of zero-private #109). Month first, as US forms read it; the
+    day-first spellings are listed too, since some pages show them."""
+    for fmt in _DATE_INPUTS:
+        try:
+            d = datetime.strptime(value.strip(), fmt)
+            break
+        except ValueError:
+            continue
+    else:
+        return []
+    y, m, dd = d.year, d.month, d.day
+    full, short = d.strftime("%B"), d.strftime("%b")
+    out = [f"{y}-{m:02d}-{dd:02d}", f"{y}/{m:02d}/{dd:02d}", f"{y}{m:02d}{dd:02d}", f"{m:02d}{dd:02d}{y}"]
+    for mm, day in ((f"{m:02d}", f"{dd:02d}"), (str(m), str(dd))):
+        for sep in ("/", "-", "."):
+            out += [f"{mm}{sep}{day}{sep}{y}", f"{mm}{sep}{day}{sep}{y % 100:02d}", f"{day}{sep}{mm}{sep}{y}"]
+    for name in (full, short, short + "."):
+        for day in (str(dd), f"{dd:02d}"):
+            out += [f"{name} {day}, {y}", f"{name} {day} {y}", f"{day} {name} {y}", f"{day} {name}, {y}"]
+            out += [o.upper() for o in out[-4:]]
+    return out
+
+
+def redaction_values(kind: str, secret: Dict[str, Any]) -> List[str]:
+    """Every value of a vault item the model must never read back, in the forms a page shows it.
+
+    Exact values of every secret field, plus the common reformattings of a card number and an ID number
+    (digits only, groups of four, 3-2-4, with spaces or dashes), of a phone and of a date of birth. Fields seen as metadata
+    and values under three characters are left out (see ``_NOT_REDACTED``)."""
+    out: List[str] = []
+    for field, value in (secret or {}).items():
+        value = str(value or "")
+        if field in _NOT_REDACTED or len(value.strip()) < 3:
+            continue
+        out.append(value)
+        if field == "phone":
+            out.extend(_phone_formats(value))
+        if field == "value":   # a form may drop the dashes in a license or passport number (Codex review of zero-private #109)
+            out.append(re.sub(r"[\s-]", "", value))
+        if field == "value" and str((secret or {}).get("id_type") or "") == "dob":
+            out.extend(_date_formats(value))
+        if field in ("card_number", "value"):
+            digits = re.sub(r"\D", "", value)
+            if len(digits) >= 6 and len(digits) >= len(re.sub(r"[\s-]", "", value)):
+                out.extend(_digit_groupings(digits))
+    return list(dict.fromkeys(out))
+
+

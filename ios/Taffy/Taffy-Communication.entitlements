<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifications from the hub (Push.swift). Debug installs use Apple's sandbox. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Notifications show as messages from a Zip, with its avatar (NotificationService, Oct 10). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- Shared with the notification extension: each Zip's name and avatar (PushShared/ZipNotify.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.Taffy</string>
	</array>
</dict>
</plist>

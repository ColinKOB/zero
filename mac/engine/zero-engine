#!/bin/bash
# zero-engine: installs, runs and removes Zero's engine on this Mac, for the person who is logged in.
#
# The Mac app runs this from Zero.app/Contents/Resources/Engine (through its native helper), and it works the same
# from Terminal, so every step can be tested without the app:
#
#   zero-engine install         download and set up everything, register the background services, start them
#   zero-engine start | stop    load or unload the background services
#   zero-engine status          one JSON object: installed, running, ports, the local hub's health
#   zero-engine ai-status       one JSON object: Claude Code and Codex, installed and signed in (no secrets)
#   zero-engine configure-ai    point the Zips at whichever plan is signed in now, then restart the gateway
#   zero-engine pair [minutes]  a one-time pairing code, plus the link the phone opens on the same Wi-Fi
#   zero-engine soul            after the onboarding, put the person's name in the lead's SOUL
#   zero-engine uninstall [--keep-data | --delete-data]
#                               stop and remove the background services and the engine; with --delete-data also
#                               the person's chats, Zips and ~/Zero Work
#
# Lines that start with "ZERO-STEP n total text", "ZERO-ERROR text" and "ZERO-DONE" are for the app's progress
# screen; their text is written for the person. Everything else is detail for the log.
#
# What it puts where (docs/plans/2026-10-08-mac-home-packaging-plan.md, the thin slice built on Oct 12):
#   ~/Library/Application Support/Zero/    bin/uv, python/, venv/, engine/{hermes,hub-src,plugins,lib},
#                                           hermes/ (HERMES_HOME), hub-state/, shared/, home.json, engine.json, logs/
#   ~/Zero Work/                            what the Zips make, where the person finds it in Finder
#   ~/Library/LaunchAgents/<label>.hub.plist and <label>.gateway.plist
#
# Test hooks: ZERO_ROOT (the engine folder), ZERO_WORK (the work folder), ZERO_LABEL (the LaunchAgent label prefix)
# and ZERO_LAUNCH_AGENTS (where the plists go) let a test run beside a real install without touching it.
# ZERO_DOWNLOAD_CACHE reuses downloads between test runs (checked against the same hashes).

set -u
set -o pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="${ZERO_ROOT:-$HOME/Library/Application Support/Zero}"
WORK="${ZERO_WORK:-$HOME/Zero Work}"
LABEL="${ZERO_LABEL:-com.example.Zero}"
AGENTS="${ZERO_LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}"
SRC="$HERE/src"

# Pinned downloads. Hermes is the commit alien runs (docs/plans/2026-10-09-zero-for-anyone-plan.md, section 1),
# with alien's patches on top; the Claude plan plugin is the commit Hermes's own catalog pins. Each archive is
# checked against the hash recorded here when it was first downloaded (Oct 12, 2026).
UV_VERSION="0.13.0"
UV_URL="https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-aarch64-apple-darwin.tar.gz"
UV_SHA256="a9c1b29002cf3c83f07fa9cd8a887a3be0107d90e23189721221e7257db8e3d6"
PYTHON_VERSION="3.14"
HERMES_COMMIT="74943bb889b7978f9d6ff0aa77ae442547201cc2"
HERMES_URL="https://codeload.github.com/NousResearch/hermes-agent/tar.gz/${HERMES_COMMIT}"
HERMES_SHA256="6e7290642b08a221c73be5e4582e0c27e74a6a2227cd2c38e196602df7b69e8a"
DSDK_COMMIT="31b591fd04737a7807183f3d7f3d389b19f94687"
DSDK_URL="https://codeload.github.com/NousResearch/hermes-plugin-claude-subscription-directsdk/tar.gz/${DSDK_COMMIT}"
DSDK_SHA256="2a220d5a91cef700faa2d92d7584c64840f76394f9e638dee69a3671eae24a8c"
DSDK_NAME="claude-subscription-directsdk-experimental"
# The hub's own packages (hub/pyproject.toml).
HUB_PACKAGES=("fastapi==0.118.0" "uvicorn[standard]==0.37.0" "httpx[http2]==0.28.1" "pyjwt[crypto]>=2.8")

UV="$ROOT/bin/uv"
VENV="$ROOT/venv"
PY="$VENV/bin/python"
LOGS="$ROOT/logs"
STATUS="$ROOT/install-status.json"
TOTAL=8

export UV_CACHE_DIR="$ROOT/cache/uv"
export UV_PYTHON_INSTALL_DIR="$ROOT/python"
export UV_NO_CONFIG=1
export UV_PYTHON_PREFERENCE=only-managed

log() { printf '%s\n' "$*"; }
now() { date +%s; }

write_status() {   # state step text
    mkdir -p "$ROOT"
    local text="${3//\\/\\\\}"; text="${text//\"/\\\"}"
    printf '{"state": "%s", "step": %s, "total": %s, "text": "%s", "at": %s}\n' "$1" "$2" "$TOTAL" "$text" "$(now)" \
        > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
}

STEP=0
step() {   # n text
    STEP="$1"
    printf 'ZERO-STEP %s %s %s\n' "$1" "$TOTAL" "$2"
    write_status running "$1" "$2"
}

fail() {   # text for the person; detail goes to the log above it
    printf 'ZERO-ERROR %s\n' "$1"
    write_status failed "$STEP" "$1"
    exit 1
}

# Downloads a file and checks its SHA-256. A cached copy with the right hash is reused.
fetch() {   # url sha256 dest
    local url="$1" sum="$2" dest="$3" cache="${ZERO_DOWNLOAD_CACHE:-}"
    if [ -n "$cache" ] && [ -f "$cache/$sum" ]; then
        cp "$cache/$sum" "$dest"
    else
        local tries=0
        until curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 20 -o "$dest" "$url"; do
            tries=$((tries + 1))
            [ "$tries" -ge 2 ] && return 1
            sleep 3
        done
    fi
    local got
    got="$(shasum -a 256 "$dest" | awk '{print $1}')"
    if [ "$got" != "$sum" ]; then
        log "checksum mismatch for $url: expected $sum, got $got"
        rm -f "$dest"
        return 2
    fi
    if [ -n "$cache" ] && [ ! -f "$cache/$sum" ]; then mkdir -p "$cache" && cp "$dest" "$cache/$sum"; fi
    return 0
}

plist_path() { printf '%s/%s.%s.plist' "$AGENTS" "$LABEL" "$1"; }
domain() { printf 'gui/%s' "$(id -u)"; }

agent_loaded() { launchctl print "$(domain)/$LABEL.$1" >/dev/null 2>&1; }

load_agent() {   # name
    local p; p="$(plist_path "$1")"
    agent_loaded "$1" && launchctl bootout "$(domain)/$LABEL.$1" >/dev/null 2>&1
    # bootout returns before the job is gone; bootstrap fails with "Input/output error" until it is.
    local i=0
    while agent_loaded "$1" && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
    launchctl bootstrap "$(domain)" "$p" || launchctl load -w "$p"
}

unload_agent() {   # name
    if agent_loaded "$1"; then launchctl bootout "$(domain)/$LABEL.$1" >/dev/null 2>&1; fi
    local i=0
    while agent_loaded "$1" && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
}

engine_py() { "$PY" -I "$HERE/zero_engine.py" --root "$ROOT" --work "$WORK" --label "$LABEL" --agents "$AGENTS" "$@"; }

hub_port() { "$PY" -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["ports"]["hub"])' "$ROOT/engine.json" 2>/dev/null; }

wait_for_hub() {   # seconds
    local port; port="$(hub_port)"
    [ -z "$port" ] && return 1
    local i=0
    while [ "$i" -lt "$1" ]; do
        if curl -fsS -m 2 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then return 0; fi
        sleep 1; i=$((i + 1))
    done
    return 1
}

# ---------------------------------------------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------------------------------------------

cmd_install() {
    mkdir -p "$ROOT" "$LOGS" "$ROOT/bin" "$ROOT/engine" "$ROOT/cache" || fail "Zero could not make its folder on this Mac."
    exec > >(tee -a "$LOGS/install.log") 2>&1
    log "--- install $(date '+%Y-%m-%d %H:%M:%S %Z') into $ROOT"
    [ -d "$SRC/hub/taffy_hub" ] || fail "This copy of Zero is missing some of its files. Download Zero again and retry."

    step 1 "Checking this Mac."
    [ "$(uname -m)" = "arm64" ] || fail "Zero needs a Mac with Apple silicon."
    local major; major="$(sw_vers -productVersion | cut -d. -f1)"
    [ "${major:-0}" -ge 14 ] || fail "Zero needs macOS 14 or later. Update macOS in System Settings, then try again."
    local free_kb; free_kb="$(df -Pk "$HOME" | awk 'NR==2 {print $4}')"
    # About 650 MB once set up, and about 1 GB more while it downloads.
    [ "${free_kb:-0}" -ge 2000000 ] || fail "Zero needs about 2 GB of free space. Free some space, then try again."
    curl -fsS -m 15 -o /dev/null https://github.com 2>/dev/null \
        || fail "Zero could not reach the internet. Check your connection, then try again."

    step 2 "Downloading the setup tools."
    if [ ! -x "$UV" ] || [ "$("$UV" --version 2>/dev/null | awk '{print $2}')" != "$UV_VERSION" ]; then
        local tmp; tmp="$(mktemp -d)"
        fetch "$UV_URL" "$UV_SHA256" "$tmp/uv.tgz" || fail "A download did not finish or did not match. Try again."
        tar -xzf "$tmp/uv.tgz" -C "$tmp" || fail "A download could not be opened. Try again."
        install -m 755 "$tmp/uv-aarch64-apple-darwin/uv" "$UV" || fail "Zero could not save its setup tools."
        rm -rf "$tmp"
    fi
    "$UV" --version

    step 3 "Downloading the language Zero runs on."
    "$UV" python install --no-bin "$PYTHON_VERSION" || fail "A download did not finish. Check your connection, then try again."

    step 4 "Downloading Zero's engine."
    local hermes="$ROOT/engine/hermes"
    if [ "$(cat "$hermes/.zero-commit" 2>/dev/null)" != "$HERMES_COMMIT" ]; then
        local tmp; tmp="$(mktemp -d)"
        fetch "$HERMES_URL" "$HERMES_SHA256" "$tmp/hermes.tgz" || fail "A download did not finish or did not match. Try again."
        rm -rf "$hermes.new" && mkdir -p "$hermes.new"
        tar -xzf "$tmp/hermes.tgz" -C "$hermes.new" --strip-components 1 || fail "A download could not be opened. Try again."
        for p in "$SRC"/patches/*.patch; do
            [ -f "$p" ] || continue
            (cd "$hermes.new" && patch -p1 -s -N < "$p") || fail "Zero could not prepare its engine. Try again."
            log "applied $(basename "$p")"
        done
        # Hermes's own tests and website are not needed to run it.
        rm -rf "$hermes.new/tests" "$hermes.new/tests-js" "$hermes.new/website" "$hermes.new/evals"
        echo "$HERMES_COMMIT" > "$hermes.new/.zero-commit"
        rm -rf "$hermes" && mv "$hermes.new" "$hermes"
        rm -rf "$tmp"
    fi
    local dsdk="$ROOT/engine/plugins/$DSDK_NAME"
    if [ "$(cat "$dsdk/.zero-commit" 2>/dev/null)" != "$DSDK_COMMIT" ]; then
        local tmp; tmp="$(mktemp -d)"
        fetch "$DSDK_URL" "$DSDK_SHA256" "$tmp/dsdk.tgz" || fail "A download did not finish or did not match. Try again."
        rm -rf "$dsdk" && mkdir -p "$dsdk"
        tar -xzf "$tmp/dsdk.tgz" -C "$dsdk" --strip-components 1 || fail "A download could not be opened. Try again."
        rm -rf "$dsdk/tests" "$dsdk/evals" "$dsdk/assets"
        echo "$DSDK_COMMIT" > "$dsdk/.zero-commit"
        rm -rf "$tmp"
    fi

    step 5 "Installing Zero's engine. This takes a few minutes."
    if [ ! -x "$PY" ]; then
        "$UV" venv --python "$PYTHON_VERSION" "$VENV" || fail "Zero could not set up its engine. Try again."
    fi
    # Hermes's own lock file, so every package is the version Hermes was tested with; the project is installed
    # from its folder, as on alien.
    (cd "$hermes" && UV_PROJECT_ENVIRONMENT="$VENV" "$UV" sync --frozen --no-dev --extra all --python "$PY") \
        || fail "Zero could not install its engine. Check your connection, then try again."
    "$UV" pip install --python "$PY" "${HUB_PACKAGES[@]}" \
        || fail "Zero could not install its engine. Check your connection, then try again."
    rm -rf "$ROOT/cache/uv"   # the download cache; a retry or an update downloads again

    step 6 "Copying Zero's own parts."
    local eng="$ROOT/engine"
    rm -rf "$eng/hub-src.new" "$eng/plugins/taffy-tools.new" "$eng/lib.new"
    mkdir -p "$eng/hub-src.new" "$eng/plugins" "$eng/lib.new"
    cp -R "$SRC/hub/taffy_hub" "$eng/hub-src.new/" \
        && cp -R "$SRC/plugins/taffy-tools" "$eng/plugins/taffy-tools.new" \
        && cp -R "$SRC/lib/." "$eng/lib.new/" \
        || fail "Zero could not copy its files. Try again."
    rm -rf "$eng/hub-src" "$eng/plugins/taffy-tools" "$eng/lib"
    mv "$eng/hub-src.new" "$eng/hub-src" && mv "$eng/plugins/taffy-tools.new" "$eng/plugins/taffy-tools" \
        && mv "$eng/lib.new" "$eng/lib"
    find "$eng/hub-src" "$eng/plugins" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null

    step 7 "Setting up your home on this Mac."
    mkdir -p "$WORK"
    engine_py render --shared-src "$SRC/shared" || fail "Zero could not finish setting up. Try again."

    step 8 "Starting Zero."
    mkdir -p "$AGENTS"
    load_agent gateway || fail "Zero could not start in the background. Try again."
    load_agent hub || fail "Zero could not start in the background. Try again."
    load_agent lan || fail "Zero could not start in the background. Try again."
    if ! wait_for_hub 120; then
        tail -n 40 "$LOGS/hub.log" 2>/dev/null
        fail "Zero did not start. Try again, and if it still does not start, restart your Mac."
    fi
    write_status done "$TOTAL" "Zero is set up on this Mac."
    echo "ZERO-DONE"
}

# ---------------------------------------------------------------------------------------------------------------
# the other commands
# ---------------------------------------------------------------------------------------------------------------

cmd_start() {
    [ -f "$(plist_path hub)" ] || { echo "Zero is not set up on this Mac."; exit 1; }
    load_agent gateway && load_agent hub && load_agent lan
    wait_for_hub 60 && echo "running" || { echo "Zero did not start."; exit 1; }
}

cmd_stop() { unload_agent lan; unload_agent hub; unload_agent gateway; echo "stopped"; }

cmd_status() {
    if [ -x "$PY" ] && [ -f "$HERE/zero_engine.py" ]; then engine_py status; return; fi
    printf '{"installed": false, "running": false}\n'
}

cmd_ai_status() {
    # It runs on the engine's own Python, so it works once step 5 of the install is done (a clean Mac has no other).
    if [ -x "$PY" ]; then engine_py ai-status
    else printf '{"claude": {"installed": false, "signed_in": false}, "codex": {"installed": false, "signed_in": false}, "ready": false, "engine": false}\n'; fi
}

cmd_configure_ai() {
    [ -x "$PY" ] || { echo "Zero is not set up on this Mac."; exit 1; }
    engine_py configure-ai || exit 1
    agent_loaded gateway && launchctl kickstart -k "$(domain)/$LABEL.gateway" >/dev/null 2>&1
    echo "ZERO-DONE"
}

cmd_pair() {
    [ -x "$PY" ] || { echo "Zero is not set up on this Mac."; exit 1; }
    engine_py pair "${1:-15}"
}

cmd_uninstall() {
    local mode="${1:---keep-data}"
    case "$mode" in --keep-data|--delete-data) ;; *) echo "usage: zero-engine uninstall [--keep-data | --delete-data]"; exit 2;; esac
    echo "ZERO-STEP 1 3 Stopping Zero."
    unload_agent lan; unload_agent hub; unload_agent gateway
    rm -f "$(plist_path hub)" "$(plist_path gateway)" "$(plist_path lan)"
    echo "ZERO-STEP 2 3 Removing Zero's engine."
    # The engine and everything that can be downloaded again.
    # The Wi-Fi certificate goes too: a phone paired before has to pair again after a reinstall.
    rm -rf "$ROOT/venv" "$ROOT/python" "$ROOT/engine" "$ROOT/bin" "$ROOT/cache" "$ROOT/install-status.json" \
           "$ROOT/engine.json" "$ROOT/tls"
    echo "ZERO-STEP 3 3 Removing your data."
    if [ "$mode" = "--delete-data" ]; then
        rm -rf "$ROOT" "$WORK"
    else
        echo "Kept your chats, Zips and settings in $ROOT, and your files in $WORK."
    fi
    echo "ZERO-DONE"
}

case "${1:-help}" in
    install) cmd_install ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    ai-status) cmd_ai_status ;;
    configure-ai) cmd_configure_ai ;;
    pair) shift; cmd_pair "${1:-15}" ;;
    soul) [ -x "$PY" ] && engine_py soul ;;
    uninstall) shift; cmd_uninstall "${1:---keep-data}" ;;
    *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
